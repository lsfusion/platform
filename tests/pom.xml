<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- an ordinary lsFusion logics, like any application project : src/main/lsfusion is the source root -->
    <parent>
        <groupId>lsfusion.platform.build</groupId>
        <artifactId>logics</artifactId>
        <version>7.0-SNAPSHOT</version>
        <relativePath>../build/logics/pom.xml</relativePath>
    </parent>

    <groupId>lsfusion.platform</groupId>
    <artifactId>tests</artifactId>
    <packaging>jar</packaging>
    <name>Tests</name>

    <properties>
        <!-- build/base turns tests off for the whole platform; this is the module they are turned on for -->
        <maven.test.skip>false</maven.test.skip>
        <!-- the test logics is nobody's dependency, and must not reach the repository -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.compiler.source>11</maven.compiler.source>
        <surefire.version>3.2.5</surefire.version>
    </properties>

    <dependencies>
        <dependency>
            <!-- version spelled out : junit is managed in build/platform-base, which a logics does not inherit from -->
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- the runners start the server in a jvm of its own, so they need the classpath maven resolved -->
                        <id>server-classpath</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/server-classpath.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <excludes>
                        <!-- the browser tests need the ui profile -->
                        <exclude>**/Ui*IT.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- the browser tests: the web client's war in a jetty of its own, against a test server, driven by playwright -->
            <id>ui</id>
            <activation>
                <!-- so that platformTests runs the spike on its branch, as its command line has no -Pui -->
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <playwright.version>1.63.0</playwright.version>
                <!-- the jetty the web client is developed with (web-client/pom.xml) -->
                <jetty.version>9.4.58.v20250814</jetty.version>
                <!-- the run's defaults, -D overrides them : see UiSpikeIT -->
                <ui.browser>docker</ui.browser>
                <ui.repeat>30</ui.repeat>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.microsoft.playwright</groupId>
                    <artifactId>playwright</artifactId>
                    <version>${playwright.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <!-- the browser tests stay out of the build that has no playwright -->
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ui-test-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/ui/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jetty-runner</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>org.eclipse.jetty</groupId>
                                            <artifactId>jetty-runner</artifactId>
                                            <version>${jetty.version}</version>
                                            <destFileName>jetty-runner.jar</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                    <outputDirectory>${project.build.directory}/ui</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- the compile corpus has a run of its own -->
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/Ui*IT.java</include>
                            </includes>
                            <excludes combine.self="override"/>
                            <systemPropertyVariables>
                                <!-- the war of the checkout under test, built by web-client beside it -->
                                <ui.war>${project.basedir}/../web-client/target/lsfusion-client-${project.version}.war</ui.war>
                                <ui.playwrightVersion>${playwright.version}</ui.playwrightVersion>
                                <ui.browser>${ui.browser}</ui.browser>
                                <ui.repeat>${ui.repeat}</ui.repeat>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
