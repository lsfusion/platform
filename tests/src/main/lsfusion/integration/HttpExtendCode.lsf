MODULE HttpExtendCode;

REQUIRE TestUtils, SystemEvents;

// a call through the Action API is a connection of its user as a client is, so the code that customizes the application
// for the user (SystemEvents.dataExtendCode[]) customizes the call : an action the code declares is called by its name,
// and a script the call sends sees what the code declares. Every call of the test opens a session of the stateful API of
// its own (session=..._close) : one built after the code is saved, whatever the pool holds (HttpUserContext tests that)

// an action the code of the test declares under the same name : called by the bare name it is neither, with the
// namespace this one
hecLogics (INTEGER a) { RETURN a; }

// the code for all users : ExternalApiAccessIT writes it authenticated
hecSet (TEXT code) {
    dataExtendCode() <- code;
    APPLY;
} @@noauth;
hecReset () { hecSet(NULL); } @@noauth;
// an action of the logics such a server lets an anonymous call run
hecNothing () { } @@noauth;
// a code that does not compile is refused when it is saved, so one saved before that, or broken since by a change of the
// logics, is stored past the refusal
hecSetBroken (TEXT code) {
    setNoCancelInTransaction();
    hecSet(code);
    dropNoCancelInTransaction();
} @@noauth;
// what the server answers a call, or what the call fails with. Each call opens a session of a name no call has used : the
// server drops a closed session after it has answered, and a later call of the same name could still find it
hecResponse = DATA LOCAL STRING ();
hecGet (STRING request) {
    hecResponse() <- NULL;
    generateUUID();
    TRY {
        EXTERNAL HTTP GET origin() + request + '&session=' + generatedUUID() + '_close' TO hecResponse;
    } CATCH {
        hecResponse() <- messageCaughtException();
    }
}
// a script is sent as the body : in a parameter of the address a ';' would end it
hecEval (STRING script) {
    hecResponse() <- NULL;
    generateUUID();
    TRY {
        EXTERNAL HTTP POST origin() + '/eval?session=' + generatedUUID() + '_close' PARAMS script TO hecResponse;
    } CATCH {
        hecResponse() <- messageCaughtException();
    }
}

hecAnswered (STRING answer, STRING call) {
    assertTrue(hecResponse() = answer, call + ' answered ' + (OVERRIDE hecResponse(), 'nothing'));
}
hecFailed (STRING failure, STRING call) {
    assertTrue(hecResponse() LIKE '%' + failure + '%', call + ' answered ' + (OVERRIDE hecResponse(), 'nothing'));
}

hecCode () = 'hecTwice(INTEGER a) \{ RETURN a * 2; \}\n'
    + 'hecAnswer() = 42;\n'
    + 'hecLogics(INTEGER a) \{ RETURN a + 100; \}';

testCallSeesExtendCode 'A call through the Action API sees what the code of the application customization declares' () {
    hecSet(hecCode());
    TRY {
        hecGet('/exec?action=hecTwice&p=21');
        hecAnswered('42', 'An action of the code');

        hecEval('run() \{ RETURN hecAnswer(); \}');
        hecAnswered('42', 'A script');

        // no priority, as in a script evaluated in a client
        hecGet('/exec?action=hecLogics&p=1');
        hecFailed('Ambiguous element \'hecLogics\'', 'A name both declare');
        hecGet('/exec?action=HttpExtendCode.hecLogics&p=1');
        hecAnswered('1', 'That name with the namespace');
    } FINALLY {
        hecSet(NULL);
    }

    // the code is dropped : the next call does not find what it declared - and finds it again as the code is back
    hecGet('/exec?action=hecTwice&p=21');
    hecFailed('hecTwice was not found', 'An action of the dropped code');

    hecSet(hecCode());
    TRY {
        hecGet('/exec?action=hecTwice&p=21');
        hecAnswered('42', 'An action of the code that is back');
    } FINALLY {
        hecSet(NULL);
    }
}

testCallIgnoresBrokenExtendCode 'A call through the Action API goes on without a customization code that does not compile' () {
    hecSetBroken('hecTwice(INTEGER a) \{ RETURN a * 2; \}\nNAVIGATOR \{ hecNoSuchElement \'Renamed\'; \}');
    assertEquals(dataExtendCode(), 'hecTwice(INTEGER a) \{ RETURN a * 2; \}\nNAVIGATOR \{ hecNoSuchElement \'Renamed\'; \}', 'The broken code was not stored');
    TRY {
        hecGet('/exec?action=HttpExtendCode.hecLogics&p=1');
        hecAnswered('1', 'An action of the application');
        hecGet('/exec?action=hecTwice&p=21');
        hecFailed('hecTwice was not found', 'An action of the broken code');
    } FINALLY {
        hecSet(NULL);
    }
}

// an EVAL inside a script a call sends sees what that script declares, as one inside an EVAL does : the call evaluates
// the script itself, with no EVAL around it whose script the inner one would see
testNestedEvalSeesTheScript 'An EVAL inside a script a call sends sees what that script declares' () {
    hecEval('hecOuter() = 21;\n'
        + 'hecResult = DATA LOCAL INTEGER ();\n'
        + 'run() \{ EVAL ACTION \'hecResult() <- hecOuter() * 2;\'; RETURN hecResult(); \}');
    hecAnswered('42', 'A script with an EVAL inside');
}

// a script evaluated by an action of the logics - an EVAL written in no script - inside a script a call sends sees what
// that script declares : the script that runs it
hecEvalText (STRING text) { EVAL ACTION text; }

testEvalOfLogicsSeesTheScript 'An EVAL of the logics run inside a script a call sends sees what that script declares' () {
    hecEval('hecOuter() = 21;\n'
        + 'hecResult = DATA LOCAL INTEGER ();\n'
        + 'run() \{ HttpExtendCode.hecEvalText(\'hecResult() <- hecOuter() * 2;\'); RETURN hecResult(); \}');
    hecAnswered('42', 'A script running an EVAL of the logics');
}
