MODULE HttpRoleSettings;

REQUIRE Security, Authentication, Service, Reflection;

// the server's enableAPI and a role's own one, set as an administrator sets them. Open to the calls of
// ExternalApiAccessIT, which are anonymous on a server that lets only an authenticated call in

// a user of a role of its own with the given enableAPI (NULL - the server's), and a token given to the user. The role
// cannot open the interpreter, which opens the API to its users whatever enableAPI is, so that the setting alone decides
hrsUser (STRING login, STRING enableAPI) {
    NEWSESSION {
        NEW r = UserRole {
            sid(r) <- login;
            NEW u = CustomUser {
                login(u) <- login;
                in(u, r) <- TRUE;
            }
            baseValue(setting('enableAPI'), r) <- enableAPI;
            dataPermission(r, navigatorElementCanonicalName('System.interpreter')) <- Permission.forbid;
        }
        APPLY;
    }
    generateAuthToken(login);
    RETURN resultAuthToken();
} @@noauth;

// a user of a role of its own that may open the interpreter from the navigator, and a token given to the user. kind :
// 'readonly' - the role may change nothing, the interpreter's run among it, 'noview' - the role may not see the run,
// 'noui' - the role's enableUI is 0, NULL - none of them, the user can run code in the interpreter
hrsInterpreterUser (STRING login, STRING kind) {
    NEWSESSION {
        NEW r = UserRole {
            sid(r) <- login;
            NEW u = CustomUser {
                login(u) <- login;
                in(u, r) <- TRUE;
            }
            IF kind = 'readonly' THEN
                dataPermissionChange(r, propertyGroup('System_root')) <- Permission.forbid;
            IF kind = 'noview' THEN
                dataPermissionView(r, actionCanonicalName('System.executeScript[System.Script]')) <- Permission.forbid;
            IF kind = 'noui' THEN
                baseValue(setting('enableUI'), r) <- '0';
        }
        APPLY;
    }
    generateAuthToken(login);
    RETURN resultAuthToken();
} @@noauth;

// a user of two roles of its own, and a token given to the user. The first role is disabled, with the given enableAPI
// (first); it is made first, so it is the one whose settings the user would get if it were not disabled. The second
// has the given enableAPI (second, NULL - the server's) and cannot open the interpreter, which opens the API to its
// users whatever enableAPI is - the first cannot forbid it, as a disabled role's permissions do not apply
hrsDisabledFirstRoleUser (STRING login, STRING first, STRING second) {
    NEWSESSION {
        NEW r = UserRole {
            sid(r) <- login;
            baseValue(setting('enableAPI'), r) <- first;
            disableRole(r) <- TRUE;
            NEW next = UserRole {
                sid(next) <- login + 'Next';
                baseValue(setting('enableAPI'), next) <- second;
                dataPermission(next, navigatorElementCanonicalName('System.interpreter')) <- Permission.forbid;
                NEW u = CustomUser {
                    login(u) <- login;
                    in(u, r) <- TRUE;
                    in(u, next) <- TRUE;
                }
            }
        }
        APPLY;
    }
    generateAuthToken(login);
    RETURN resultAuthToken();
} @@noauth;

// the role whose settings a user without an enabled role of its own gets: by default - default, and NULL - the server's
// settings - once default is disabled, read in a session that is not applied
hrsFallbackRole = DATA LOCAL STRING ();
hrsFallbackRoles () {
    NEWSESSION NESTED (hrsFallbackRole) {
        NEW u = CustomUser {
            hrsFallbackRole() <- OVERRIDE sid(firstRole(u)), 'NULL';
            disableRole(userRoleSID('default')) <- TRUE;
            hrsFallbackRole() <- hrsFallbackRole() + ' ' + (OVERRIDE sid(firstRole(u)), 'NULL');
        }
    }
    RETURN hrsFallbackRole();
} @@noauth;

hrsServer (STRING enableAPI) {
    baseValue(setting('enableAPI')) <- enableAPI;
    APPLY;
} @@noauth;

// an action of the logics with no annotations
hrsPing () {
    RETURN 'pong';
}
