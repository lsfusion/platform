MODULE HttpPasswordReset;

REQUIRE Authentication, Email, Reflection, Time;

// what an administrator sets up for the password pages : the mail account their mails are sent by, and the address of
// the web server their links lead to. Open, as the rest, to the calls of PasswordResetIT, which are anonymous on a
// server that lets the API in only for what an action opens
hprMailBy (INTEGER port) {
    NEW a = Account {
        name(a) <- 'hpr';
        smtpHost(a) <- 'localhost';
        smtpPort(a) <- STRING[10](port);
        fromAddress(a) <- 'hpr@example.com';
        isDefaultInbox(a) <- TRUE;
    }
    APPLY;
} @@noauth;

hprAddress (STRING url) {
    Reflection.webServerUrl() <- url;
    APPLY;
} @@noauth;
hprNoAddress () {
    Reflection.webServerUrl() <- NULL;
    APPLY;
} @@noauth;

hprUser (STRING login, STRING email) {
    NEW u = CustomUser {
        login(u) <- login;
        email(u) <- email;
    }
    APPLY;
} @@noauth;

// the last reset mail of the user as sent the given number of seconds ago
hprSentAgo (STRING login, INTEGER seconds) {
    expiryPasswordResetTokenDate(customUserLogin(login)) <- subtractSeconds(currentDateTime(), seconds);
    APPLY;
} @@noauth;
