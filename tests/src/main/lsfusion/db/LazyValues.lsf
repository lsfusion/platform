MODULE LazyValues;

REQUIRE TestUtils;

// the server caches the values of LAZY properties, and the lists of values an editor asks for, until the properties they
// depend on change : a read registers itself in a set of the property's, which a change drops. Two first reads of one
// property at once each made a set of their own and put it, the second over the first, and the read registered in the
// one replaced was never dropped - its value stayed cached through the changes

lvName = DATA LOCAL STRING ();

lvFailure = DATA LOCAL STRING ();
lvReadAtOnce INTERNAL 'lsfusion.tests.ReadLazyValuesAtOnceAction' ();

testLazyValuesReadAtOnce 'Two reads of one property at once register in one set of it' () {
    lvReadAtOnce();
    assertNull(lvFailure(), lvFailure());
}
