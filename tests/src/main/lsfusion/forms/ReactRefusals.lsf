MODULE ReactRefusals;

REQUIRE TestUtils;

// what a CUSTOM REACT component draws or places has no tab strip and no collapse header of the platform's - the
// component shows it or not -, so a scripted ACTIVATE TAB, COLLAPSE or EXPAND on it is refused at run time. A
// platform-drawn container the component places is placed, so refused as well, but what is inside it the platform draws
// again: a tab or a collapsible container there is activated or collapsed as anywhere else - unless the platform-drawn
// container is a nested CUSTOM REACT one, which draws its insides itself - a custom of its own makes it platform-drawn

rrScript = DATA LOCAL STRING ();

rrIslandNote = DATA LOCAL STRING ();
rrPlacedNote = DATA LOCAL STRING ();
rrPlatformNote = DATA LOCAL STRING ();

FORM rrBoard 'Board'
    PROPERTIES() rrIslandNote, rrPlacedNote, rrPlatformNote
;

DESIGN rrBoard {
    NEW rrReact {
        custom = 'RrBoard';
        NEW rrPages {
            tabbed = TRUE;
            NEW rrFirstPage;
            NEW rrSecondPage;
        }
        NEW rrPane {
            collapsible = TRUE;
        }
        NEW rrIsland {
            custom = NULL;
            NEW rrIslandPages {
                tabbed = TRUE;
                NEW rrIslandFirst;
                NEW rrIslandSecond { MOVE PROPERTY(rrIslandNote()); }
            }
            NEW rrIslandPane {
                collapsible = TRUE;
            }
        }
        NEW rrPlacedPages {
            custom = NULL;
            tabbed = TRUE;
            NEW rrPlacedFirst;
            NEW rrPlacedSecond { MOVE PROPERTY(rrPlacedNote()); }
        }
        NEW rrNested {
            custom = 'RrNested';
            NEW rrNestedPages {
                tabbed = TRUE;
                NEW rrNestedFirst;
                NEW rrNestedSecond;
            }
        }
    }
    NEW rrPlatformPages {
        tabbed = TRUE;
        NEW rrPlatformFirst;
        NEW rrPlatformSecond { MOVE PROPERTY(rrPlatformNote()); }
    }
}

EXTEND FORM rrBoard
    EVENTS ON INIT {
        IF rrScript() = 'activate react tab' THEN ACTIVATE TAB rrBoard.rrSecondPage;
        IF rrScript() = 'collapse react pane' THEN COLLAPSE CONTAINER rrBoard.rrPane;
        IF rrScript() = 'expand react pane' THEN EXPAND CONTAINER rrBoard.rrPane;
        IF rrScript() = 'collapse island' THEN COLLAPSE CONTAINER rrBoard.rrIsland;
        IF rrScript() = 'activate nested tab' THEN ACTIVATE TAB rrBoard.rrNestedSecond;
        IF rrScript() = 'activate island tab' THEN ACTIVATE TAB rrBoard.rrIslandSecond;
        IF rrScript() = 'collapse island pane' THEN COLLAPSE CONTAINER rrBoard.rrIslandPane;
        IF rrScript() = 'activate placed tab' THEN ACTIVATE TAB rrBoard.rrPlacedSecond;
        IF rrScript() = 'activate platform tab' THEN ACTIVATE TAB rrBoard.rrPlatformSecond;
    }
;

// opens the board, its ON INIT running the script; what it fails with is in messageCaughtException()
rrShow (STRING script) {
    rrScript() <- script;
    TRY {
        SHOW rrBoard NOWAIT;
    } CATCH {
    }
}

testActivateTabReactDrawsIsRefused 'ACTIVATE TAB on a tab a React component draws is refused' () {
    rrShow('activate react tab');
    assertNotNull(messageCaughtException(), 'ACTIVATE TAB on a tab React draws was not refused');
    assertTrue(messageCaughtException() LIKE '%ACTIVATE TAB%rrSecondPage%CUSTOM REACT%', 'ACTIVATE TAB failed with ' + messageCaughtException());
}

testCollapseReactDrawsIsRefused 'COLLAPSE on a container a React component draws is refused' () {
    rrShow('collapse react pane');
    assertNotNull(messageCaughtException(), 'COLLAPSE of a container React draws was not refused');
    assertTrue(messageCaughtException() LIKE '%COLLAPSE / EXPAND%rrPane%CUSTOM REACT%', 'COLLAPSE failed with ' + messageCaughtException());
}

testExpandReactDrawsIsRefused 'EXPAND on a container a React component draws is refused' () {
    rrShow('expand react pane');
    assertNotNull(messageCaughtException(), 'EXPAND of a container React draws was not refused');
    assertTrue(messageCaughtException() LIKE '%COLLAPSE / EXPAND%rrPane%CUSTOM REACT%', 'EXPAND failed with ' + messageCaughtException());
}

testCollapseReactPlacesIsRefused 'COLLAPSE on a platform-drawn container a React component places is refused' () {
    rrShow('collapse island');
    assertNotNull(messageCaughtException(), 'COLLAPSE of a platform-drawn container React places was not refused');
    assertTrue(messageCaughtException() LIKE '%COLLAPSE / EXPAND%rrIsland%CUSTOM REACT%', 'COLLAPSE failed with ' + messageCaughtException());
}

testActivateTabNestedReactDrawsIsRefused 'ACTIVATE TAB on a tab a nested CUSTOM REACT container draws is refused' () {
    rrShow('activate nested tab');
    assertNotNull(messageCaughtException(), 'ACTIVATE TAB on a tab a nested React container draws was not refused');
    assertTrue(messageCaughtException() LIKE '%ACTIVATE TAB%rrNestedSecond%CUSTOM REACT%', 'ACTIVATE TAB failed with ' + messageCaughtException());
}

testActivateTabInPlacedContainerGoesThrough 'ACTIVATE TAB on a tab inside a platform-drawn container React places is activated' () {
    rrShow('activate island tab');
    assertNull(messageCaughtException(), 'ACTIVATE TAB inside a platform-drawn container failed with ' + messageCaughtException());
    assertTrue(ACTIVE TAB rrBoard.rrIslandSecond, 'ACTIVATE TAB inside a platform-drawn container did not activate the tab');
}

testCollapseInPlacedContainerGoesThrough 'COLLAPSE on a container inside a platform-drawn container React places goes through' () {
    rrShow('collapse island pane');
    assertNull(messageCaughtException(), 'COLLAPSE inside a platform-drawn container failed with ' + messageCaughtException());
}

testActivateTabPlacedTabbedGoesThrough 'ACTIVATE TAB on a page of a platform-drawn tabbed container React places is activated' () {
    rrShow('activate placed tab');
    assertNull(messageCaughtException(), 'ACTIVATE TAB on a page of a platform-drawn tabbed container failed with ' + messageCaughtException());
    assertTrue(ACTIVE TAB rrBoard.rrPlacedSecond, 'ACTIVATE TAB on a page of a platform-drawn tabbed container did not activate it');
}

testActivateTabPlatformDrawsGoesThrough 'ACTIVATE TAB on a tab the platform draws is activated' () {
    rrShow('activate platform tab');
    assertNull(messageCaughtException(), 'ACTIVATE TAB on a platform tab failed with ' + messageCaughtException());
    assertTrue(ACTIVE TAB rrBoard.rrPlatformSecond, 'ACTIVATE TAB on a platform tab did not activate it');
}
