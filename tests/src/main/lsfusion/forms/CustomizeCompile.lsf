MODULE CustomizeCompile;

REQUIRE TestUtils, SystemEvents, Reflection;

ccNote = DATA LOCAL TEXT ();
FORM ccForm PROPERTIES() ccNote;
ccFormName() = 'CustomizeCompile.ccForm';
ccForm() = form(ccFormName());

ccBadFormCode() = 'EXTEND FORM ccForm PROPERTIES() ccNoSuchProperty;';
ccFormObjects() = 'EXTEND FORM ccForm OBJECTS n = INTEGER PANEL;';
ccFormProperties() = 'EXTEND FORM ccForm PROPERTIES VALUE(n)';
ccBadConnCode() = 'NAVIGATOR \{ NEW ccNoSuchForm; \}';
ccConnForm() = 'FORM ccConnForm \'x\';';
ccConnNavigator() = 'NAVIGATOR \{ System.administration \{ NEW ccConnForm; \} \}';
ccConnDeclares() = 'ccConnAnswer() = 42;';
ccFormUsesConn() = 'EXTEND FORM ccForm PROPERTIES() ccConnAnswer;';

testCcFormCode () {
    compileFormExtendCode(ccFormName(), NULL, ccBadFormCode());
    assertTrue(extendCodeError() LIKE '%ccNoSuchProperty%', 'The error of the form code should name the missing property');

    compileFormExtendCode(ccFormName(), NULL, ccFormObjects());
    assertNull(extendCodeError(), 'The form code still has an error');

    compileFormExtendCode(ccFormName(), NULL, ccFormProperties());
    assertTrue(extendCodeError() LIKE '%object \'n\' is not found%', 'The personal code needs the object from the code for all users');
    compileFormExtendCode(ccFormName(), NULL, ccFormObjects() + '\n' + ccFormProperties());
    assertNull(extendCodeError(), 'The personal code should see the object from the code for all users');

    // a check of what the code makes, the objects of the form, is an error of the code as well
    compileFormExtendCode(ccFormName(), NULL, 'EXTEND FORM ccForm OBJECTS m = INTEGER MAP;');
    assertTrue(extendCodeError() LIKE '%none of required MAP propertyDraws found%', 'A MAP group without coordinates was not refused: ' + extendCodeError());

    // the code sees what the connection's code given declares, as in a connection that code customizes
    compileFormExtendCode(ccFormName(), ccConnDeclares(), ccFormUsesConn());
    assertNull(extendCodeError(), 'The form code did not see what the connection code declares: ' + extendCodeError());
    compileFormExtendCode(ccFormName(), ccBadConnCode(), ccFormUsesConn());
    assertTrue(extendCodeError() LIKE '%ccConnAnswer%', 'The form code saw a broken connection code');

    compileFormExtendCode(ccFormName(), NULL, ccBadFormCode());
    compileFormExtendCode(ccFormName(), NULL, NULL);
    assertNull(extendCodeError(), 'A NULL form code kept the previous error');
}

testCcConnectionCode () {
    compileConnectionExtendCode(ccBadConnCode());
    assertTrue(extendCodeError() LIKE '%ccNoSuchForm%', 'The error of the connection code should name the missing form');

    compileConnectionExtendCode(ccConnForm() + '\n' + ccConnNavigator());
    assertNull(extendCodeError(), 'The connection code still has an error');

    compileConnectionExtendCode('NAVIGATOR \{ NEW FOLDER ccTop; \}');
    assertTrue(extendCodeError() LIKE '%must specify a WINDOW for its children%', 'The navigator check should refuse a top folder without a window');
    compileConnectionExtendCode(NULL);
    assertNull(extendCodeError(), 'A NULL connection code kept the navigator error');
}

// each code is saved in an apply of its own - the code of the form, else the connection's.
// They stay saved, so every test drops them at its start and its end
// what the apply ended with : APPLY's own canceled[] and applyMessage[] are not taken out of the session
ccCanceled = DATA LOCAL BOOLEAN ();
ccMessage = DATA LOCAL TEXT ();
ccSaveAll (Form f, TEXT code) {
    NEWSESSION NESTED (ccCanceled, ccMessage) {
        IF f THEN
            dataExtendCode(f) <- code;
        ELSE
            dataExtendCode() <- code;
        APPLY;
        ccCanceled() <- canceled();
        ccMessage() <- applyMessage();
    }
}
ccSaveUser (Form f, TEXT code) {
    NEWSESSION NESTED (ccCanceled, ccMessage) {
        IF f THEN
            dataExtendCode(f, currentUser()) <- code;
        ELSE
            dataExtendCode(currentUser()) <- code;
        APPLY;
        ccCanceled() <- canceled();
        ccMessage() <- applyMessage();
    }
}
ccDrop (Form f) {
    ccSaveAll(f, NULL);
    ccSaveUser(f, NULL);
}
ccRefused (STRING ccMissingName, STRING what) {
    assertTrue(ccCanceled(), what + ' was saved');
    assertTrue(ccMessage() LIKE '%' + ccMissingName + '%', what + ' was refused without the compiler\'s error: ' + ccMessage());
}
ccSaved (STRING what) {
    assertNull(ccCanceled(), what + ' was refused: ' + ccMessage());
}

testCcFormSave () {
    ccDrop(ccForm());

    // a code that does not compile is not saved, whoever writes it
    ccSaveUser(ccForm(), ccBadFormCode());
    ccRefused('ccNoSuchProperty', 'a broken personal code');
    ccSaveAll(ccForm(), ccBadFormCode());
    ccRefused('ccNoSuchProperty', 'a broken code for all users');
    assertNull(dataExtendCode(ccForm()), 'the broken code for all users is stored');
    assertNull(dataExtendCode(ccForm(), currentUser()), 'the broken personal code is stored');

    // a personal code is compiled after the code for all users, which is compiled by itself
    ccSaveAll(ccForm(), ccFormObjects());
    ccSaved('a code for all users');
    ccSaveUser(ccForm(), ccFormProperties());
    ccSaved('a personal code using an object of the code for all users');

    // a code dropped is not compiled : the code for all users is dropped though the personal code needs it
    ccSaveAll(ccForm(), NULL);
    ccSaved('a drop of the code for all users');
    assertEquals(dataExtendCode(ccForm(), currentUser()), ccFormProperties(), 'the personal code is not stored');
    // and a code written back as it is stored is not compiled either
    ccSaveUser(ccForm(), ccFormProperties());
    ccSaved('a personal code written back');
    ccSaveUser(ccForm(), ccFormProperties() + ' ');
    ccRefused('object \'n\' is not found', 'a broken personal code written anew');

    ccDrop(ccForm());
}

testCcConnectionSave () {
    ccDrop(NULL);

    ccSaveUser(NULL, ccBadConnCode());
    ccRefused('ccNoSuchForm', 'a broken personal connection code');
    ccSaveAll(NULL, ccBadConnCode());
    ccRefused('ccNoSuchForm', 'a broken connection code for all users');
    ccSaveUser(NULL, 'NAVIGATOR \{ NEW FOLDER ccTop; \}');
    ccRefused('must specify a WINDOW for its children', 'a code the navigator check refuses');
    ccSaveAll(NULL, 'CLASS CcClass;');
    ccRefused('CLASS statement cannot be used in EVAL module', 'a code declaring a class');
    assertNull(dataExtendCode(), 'the broken connection code for all users is stored');
    assertNull(dataExtendCode(currentUser()), 'the broken personal connection code is stored');

    ccSaveAll(NULL, ccConnForm());
    ccSaved('a connection code for all users');
    ccSaveUser(NULL, ccConnNavigator());
    ccSaved('a personal connection code using a form of the code for all users');
    ccSaveAll(NULL, NULL);
    ccSaved('a drop of the connection code for all users');

    ccDrop(NULL);
}

// a form's code is compiled with the connection's code it is used with, as it is stored : not the one the connection that
// saves it was made with (this test's has none)
testCcFormSaveOverConnection () {
    ccDrop(ccForm());
    ccDrop(NULL);

    ccSaveUser(ccForm(), ccFormUsesConn());
    ccRefused('ccConnAnswer', 'a form code using what no connection code declares');
    ccSaveAll(NULL, ccConnDeclares());
    ccSaved('a connection code');
    ccSaveUser(ccForm(), ccFormUsesConn());
    ccSaved('a form code using what the connection code declares');

    ccDrop(ccForm());
    ccDrop(NULL);
}

// the actions that write the current user's code without a dialog are refused the same way : the call fails with the
// compiler's error, and nothing is saved
testCcFormUserRefused () {
    ccDrop(ccForm());
    messageCaughtException() <- NULL;
    TRY {
        customizeFormUser(ccFormName(), ccBadFormCode());
    } CATCH {
    }
    assertTrue(messageCaughtException() LIKE '%ccNoSuchProperty%', 'a broken form code failed the call with ' + messageCaughtException());
    assertNull(dataExtendCode(ccForm(), currentUser()), 'the broken form code is stored');
}

testCcNavigatorUserRefused () {
    ccDrop(NULL);
    messageCaughtException() <- NULL;
    TRY {
        customizeNavigatorUser(ccBadConnCode());
    } CATCH {
    }
    assertTrue(messageCaughtException() LIKE '%ccNoSuchForm%', 'a broken connection code failed the call with ' + messageCaughtException());
    assertNull(dataExtendCode(currentUser()), 'the broken connection code is stored');
}
