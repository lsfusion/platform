MODULE ReactSelect;

REQUIRE TestUtils, Utils;

// a property's selection - the options of a link, read all at once - where a React view draws the property. The view
// draws the value from its data: the automatic selection, which the platform builds for its own element of such a link,
// is not built for it - it would hand the view the JSON list of the options instead of the value. Before the fix it was
// built for a panel property the view draws, and not for a column of the rows it draws

CLASS RsStatus 'Status';
rsName 'Name' = DATA STRING[20] (RsStatus);

CLASS RsOrder 'Order';
rsStatus = DATA RsStatus (RsOrder);
rsNameStatus 'Status' (RsOrder o) = rsName(rsStatus(o));

// the statuses, kept: the form reads how many options a selection has from the database, before it builds one
rsSeedStatuses () {
    IF NOT (GROUP SUM 1 IF RsStatus s IS RsStatus) THEN {
        NEW s = RsStatus { rsName(s) <- 'New'; }
        NEW s = RsStatus { rsName(s) <- 'Done'; }
        NEW s = RsStatus { rsName(s) <- 'Lost'; }
        APPLY;
    }
}

FORM rsAutomatic 'Automatic selection'
    OBJECTS o = RsOrder PANEL
    PROPERTIES(o) status = rsNameStatus
;

DESIGN rsAutomatic {
    NEW board FIRST { custom = 'RsBoard'; MOVE BOX(o); }
}

// ... and the platform's own panel: its element of the link is the selection, the list of the options
FORM rsPlatform 'Platform selection'
    OBJECTS o = RsOrder PANEL
    PROPERTIES(o) status = rsNameStatus
;

testRsAutomaticSelectionNotForAReactView 'A React view is sent the value of a panel property it draws, not an automatic selection' () {
    rsSeedStatuses();
    NEW o = RsOrder {
        rsStatus(o) <- GROUP MAX RsStatus s IF rsName(s) = 'Done';
        SHOW rsAutomatic OBJECTS o = o NOWAIT {
            readSent('status');
            assertEquals(sentInForm('status'), 'Done', CONCAT '', 'a panel property a React view draws was sent ',
                         (OVERRIDE sentInForm('status'), 'nothing'), ' instead of its value');
        };
        SHOW rsPlatform OBJECTS o = o NOWAIT {
            readSent('status');
            assertTrue(isSubstring(sentInForm('status'), '"selected"'), CONCAT '', 'the platform panel was sent ',
                       (OVERRIDE sentInForm('status'), 'nothing'), ', not its selection: the test no longer reaches what it tests');
        };
    }
}

// a property's selection is apart from who draws the property: SELECT alone, where a React view draws the property,
// leaves the property to the view; with NOCUSTOM - the platform's view - the platform draws its element of the
// selection, which the view places; a render function given in CUSTOM draws the selection, given its options as the
// platform's element is; NOSELECT keeps the render function, SELECT the editor - and a property with an editor of its
// own has no selection; the design's select and custom = NULL combine the same, whichever comes first. Before, they
// were one setting, the one given last winning: SELECT made the platform draw the property inside a React view,
// NOCUSTOM dropped a SELECT, a SELECT dropped a render function and NOSELECT too. The element type SELECT gives is the
// platform's element's, taken only where that element draws (the corpus: SelectTypeWithCustom, SelectTypeInReact)
FORM rsSelects 'Selections'
    OBJECTS o = RsOrder PANEL
    PROPERTIES(o) projected = rsNameStatus SELECT,
                  placed = rsNameStatus SELECT 'buttonGroup' NOCUSTOM,
                  drawnBy = rsNameStatus CUSTOM 'rsStatusButtons' SELECT,
                  plain = rsNameStatus CUSTOM 'rsStatusButtons' NOSELECT,
                  edited = rsNameStatus CUSTOM CHANGE 'rsStatusEditor' SELECT,
                  designed = rsNameStatus
;

DESIGN rsSelects {
    NEW board FIRST { custom = 'RsBoard'; MOVE BOX(o); }
    PROPERTY(designed) { select = 'dropdown'; custom = NULL; }
}

testRsSelectionApartFromWhoDraws 'A selection is apart from who draws the property' () {
    assertDrawn('ReactSelect.rsSelects', 'projected', 'react');
    assertDrawn('ReactSelect.rsSelects', 'placed', 'platform');
    assertDrawn('ReactSelect.rsSelects', 'drawnBy', 'platform');
    assertDrawn('ReactSelect.rsSelects', 'designed', 'platform');
    rsSeedStatuses();
    NEW o = RsOrder {
        rsStatus(o) <- GROUP MAX RsStatus s IF rsName(s) = 'Done';
        SHOW rsSelects OBJECTS o = o NOWAIT {
            readSent('placed');
            assertEquals(renderInForm('placed'), 'selectNullButtonGroup', CONCAT '', 'SELECT with NOCUSTOM is drawn by ',
                         (OVERRIDE renderInForm('placed'), 'nothing'), ', not by the element of the platform');
            readSent('drawnBy');
            assertEquals(renderInForm('drawnBy'), 'rsStatusButtons', CONCAT '', 'SELECT with CUSTOM is drawn by ',
                         (OVERRIDE renderInForm('drawnBy'), 'nothing'), ', not by the render function');
            assertTrue(isSubstring(sentInForm('drawnBy'), '"selected"'), CONCAT '', 'the render function of a selection is sent ',
                       (OVERRIDE sentInForm('drawnBy'), 'nothing'), ', not the options');
            readSent('plain');
            assertEquals(renderInForm('plain'), 'rsStatusButtons', CONCAT '', 'CUSTOM with NOSELECT is drawn by ',
                         (OVERRIDE renderInForm('plain'), 'nothing'), ', not by the render function');
            assertEquals(sentInForm('plain'), 'Done', CONCAT '', 'CUSTOM with NOSELECT is sent ',
                         (OVERRIDE sentInForm('plain'), 'nothing'), ', not the value');
            readSent('edited');
            assertTrue(NOT renderInForm('edited'), CONCAT '', 'SELECT given after CUSTOM CHANGE is drawn by ',
                       renderInForm('edited'), ': the editor is dropped');
            readSent('designed');
            assertEquals(renderInForm('designed'), 'selectNullDropdown', CONCAT '', 'select with custom = NULL after it is drawn by ',
                         (OVERRIDE renderInForm('designed'), 'nothing'), ', not by the element of the platform');
        };
    }
}

// ... and a form embedding another one has its selections as the embedded form has them
FORM rsEmbedded 'Embedded selections'
    FORMS rsSelects
;

testRsSelectionEmbedded 'A form embedding another has its selections apart from who draws them' () {
    rsSeedStatuses();
    NEW o = RsOrder {
        SHOW rsEmbedded OBJECTS o = o NOWAIT {
            readSent('placed');
            assertEquals(renderInForm('placed'), 'selectNullButtonGroup', CONCAT '', 'an embedded SELECT with NOCUSTOM is drawn by ',
                         (OVERRIDE renderInForm('placed'), 'nothing'), ', not by the element of the platform');
            readSent('drawnBy');
            assertEquals(renderInForm('drawnBy'), 'rsStatusButtons', CONCAT '', 'an embedded SELECT with CUSTOM is drawn by ',
                         (OVERRIDE renderInForm('drawnBy'), 'nothing'), ', not by the render function');
        };
    }
}

// a selection of several values: what it is given and how its value joins the options
CLASS RsTag 'Tag';
rsTagName 'Name' = DATA STRING[20] (RsTag);
rsIn 'In' = DATA BOOLEAN (RsOrder, RsTag);
rsTags 'Tags' (RsOrder o) = GROUP CONCAT rsTagName(RsTag t) IF rsIn(o, t), ', ' ORDER rsTagName(t), t;
rsTagsBackwards 'Tags backwards' (RsOrder o) = GROUP CONCAT rsTagName(RsTag t) IF rsIn(o, t), '; ' ORDER DESC rsTagName(t), t;
rsUpperTags 'Tags in capitals' (RsOrder o) = upper(rsTagsBackwards(o));
rsTagsSeparator = DATA STRING ();
rsComputedTags 'Tags joined as computed' (RsOrder o) = GROUP CONCAT rsTagName(RsTag t) IF rsIn(o, t), rsTagsSeparator() ORDER rsTagName(t), t;
rsEitherTags 'Tags either way' (RsOrder o) = OVERRIDE rsTagsBackwards(o), rsComputedTags(o);
rsPaddedName 'Padded name' = DATA BPSTRING (RsTag);
rsPaddedTags 'Padded tags' (RsOrder o) = GROUP CONCAT rsPaddedName(RsTag t) IF rsIn(o, t), '; ' ORDER rsPaddedName(t), t;
rsMarked 'Marked' = DATA TBOOLEAN (RsOrder, RsTag);
rsMarkedTags 'Marked tags' (RsOrder o) = GROUP CONCAT rsTagName(RsTag t) IF rsMarked(o, t), '; ' ORDER rsTagName(t), t;
rsEitherMarkedTags 'Tags or marked tags' (RsOrder o) = OVERRIDE rsTagsBackwards(o), rsMarkedTags(o);

rsSeedTags () {
    IF NOT (GROUP SUM 1 IF RsTag t IS RsTag) THEN {
        NEW t = RsTag { rsTagName(t) <- 'red'; }
        NEW t = RsTag { rsTagName(t) <- 'green'; }
        NEW t = RsTag { rsTagName(t) <- 'blue'; }
        APPLY;
    }
}

FORM rsLookup 'Selections of several values'
    OBJECTS o = RsOrder PANEL
    PROPERTIES(o) viewTags = rsTags SELECT
    PROPERTIES(o) upperTags = rsUpperTags SELECT 'input', eitherTags = rsEitherTags SELECT 'input', computedTags = rsComputedTags SELECT 'input',
                  paddedTags = rsPaddedTags SELECT 'input', markedTags = rsMarkedTags SELECT 'input',
                  eitherMarkedTags = rsEitherMarkedTags SELECT 'input'
;

DESIGN rsLookup {
    NEW board FIRST { custom = 'RsBoard'; MOVE PROPERTY(viewTags); }
}

// a selection of several values says the text a React view joins the options checked by into its value: its GROUP
// CONCAT's separator where it is a literal - whatever is put over the CONCAT, whatever its names or its condition are -,
// of a union the one all its cases join by, a comma where there is none
testRsSeparatorOfSeveralValues 'A selection of several values is sent the separator its value joins the options by' () {
    rsSeedTags();
    NEW o = RsOrder {
        SHOW rsLookup OBJECTS o = o NOWAIT {
            readSent('viewTags');
            assertEquals(separatorInForm('viewTags'), ', ', CONCAT '', 'a selection of several values was sent the separator [',
                         (OVERRIDE separatorInForm('viewTags'), 'none'), '], not [, ]');
            readSent('upperTags');
            assertTrue(isSubstring(renderInForm('upperTags'), 'select'), 'upper(tags) has no selection: the test no longer reaches what it tests');
            assertEquals(separatorInForm('upperTags'), '; ', CONCAT '', 'upper(tags) was sent the separator [',
                         (OVERRIDE separatorInForm('upperTags'), 'none'), '], not [; ]');
            readSent('paddedTags');
            assertTrue(isSubstring(renderInForm('paddedTags'), 'select'), 'the padded tags have no selection: the test no longer reaches what it tests');
            assertEquals(separatorInForm('paddedTags'), '; ', CONCAT '', 'the padded tags were sent the separator [',
                         (OVERRIDE separatorInForm('paddedTags'), 'none'), '], not [; ]');
            readSent('markedTags');
            assertTrue(isSubstring(renderInForm('markedTags'), 'select'), 'the marked tags have no selection: the test no longer reaches what it tests');
            assertEquals(separatorInForm('markedTags'), '; ', CONCAT '', 'the marked tags were sent the separator [',
                         (OVERRIDE separatorInForm('markedTags'), 'none'), '], not [; ]');
            // ... a comma where the CONCAT's separator is computed, and of a union whose cases join by different texts
            readSent('computedTags');
            assertTrue(isSubstring(renderInForm('computedTags'), 'select'), 'the tags joined as computed have no selection: the test no longer reaches what it tests');
            assertEquals(separatorInForm('computedTags'), ', ', CONCAT '', 'the tags joined as computed were sent the separator [',
                         (OVERRIDE separatorInForm('computedTags'), 'none'), '], not [, ]');
            readSent('eitherTags');
            assertTrue(isSubstring(renderInForm('eitherTags'), 'select'), 'OVERRIDE of tags has no selection: the test no longer reaches what it tests');
            assertEquals(separatorInForm('eitherTags'), ', ', CONCAT '', 'OVERRIDE of tags was sent the separator [',
                         (OVERRIDE separatorInForm('eitherTags'), 'none'), '], not [, ]');
            // ... the cases' own where they all join by one
            readSent('eitherMarkedTags');
            assertTrue(isSubstring(renderInForm('eitherMarkedTags'), 'select'), 'OVERRIDE of tags and marked tags has no selection: the test no longer reaches what it tests');
            assertEquals(separatorInForm('eitherMarkedTags'), '; ', CONCAT '', 'OVERRIDE of tags and marked tags was sent the separator [',
                         (OVERRIDE separatorInForm('eitherMarkedTags'), 'none'), '], not [; ]');
        };
    }
}

// a React view is given all the options of a selection at once, also where the platform's element is given only the
// ones picked and looks the rest up by the text typed: over more options than a drop-down list holds (Settings
// maxInterfaceStatForValueDropdown, 20)
CLASS RsLabel 'Label';
rsLabelName 'Name' = DATA STRING[20] (RsLabel);
rsLabelled 'Labelled' = DATA BOOLEAN (RsOrder, RsLabel);
rsLabels 'Labels' (RsOrder o) = GROUP CONCAT rsLabelName(RsLabel l) IF rsLabelled(o, l), ', ' ORDER rsLabelName(l), l;

rsSeedLabels () {
    IF NOT (GROUP SUM 1 IF RsLabel l IS RsLabel) THEN {
        FOR iterate(INTEGER i, 1, 25) NEW l = RsLabel DO
            rsLabelName(l) <- CONCAT '', 'label', STRING(i);
        APPLY;
    }
}

FORM rsAllLabels 'All the labels'
    OBJECTS o = RsOrder PANEL
    PROPERTIES(o) viewLabels = rsLabels SELECT, platformLabels = rsLabels SELECT
;

DESIGN rsAllLabels {
    NEW board FIRST { custom = 'RsBoard'; MOVE PROPERTY(viewLabels); }
}

testRsAllOptionsForAReactView 'A React view is given all the options of a selection at once' () {
    rsSeedLabels();
    NEW o = RsOrder {
        rsLabelled(o, RsLabel l) <- TRUE WHERE rsLabelName(l) = 'label1';
        SHOW rsAllLabels OBJECTS o = o NOWAIT {
            readSent('viewLabels');
            assertTrue(isSubstring(sentInForm('viewLabels'), '"label2"'), CONCAT '', 'a React view was sent ',
                       (OVERRIDE sentInForm('viewLabels'), 'nothing'), ', not all the options');
            readSent('platformLabels');
            assertFalse(isSubstring(sentInForm('platformLabels'), '"label2"'), CONCAT '', 'the element of the platform was sent ',
                        (OVERRIDE sentInForm('platformLabels'), 'nothing'), ': the test no longer reaches what it tests');
        };
    }
}
