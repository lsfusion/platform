MODULE UserOrdersFilters;

REQUIRE TestUtils;

// ORDER and FILTER set a group's user orders and filters on the server, so ORDERS and FILTERS later in the same action
// read what they set (#1856). They used to ask the client to set the lists and send them back: a read in between got
// the old lists, and a form with no client - as here - never got them at all

CLASS UofItem 'Item';
uofQty 'Qty' = DATA INTEGER (UofItem);

FORM uofItems 'Items'
    OBJECTS i = UofItem
    PROPERTIES(i) READONLY qty = uofQty
;

uofOrders = DATA LOCAL JSON ();
uofFilters = DATA LOCAL JSON ();
uofFiltersAgain = DATA LOCAL JSON ();

// a JSON value compares as the text it was written in, which for the same JSON differs in key order and spaces: STRING
// gives the text the database normalizes it to
testOrderReadBack 'ORDERS right after ORDER reads the orders it set' () {
    SHOW uofItems NOWAIT {
        ORDER uofItems.i FROM (JSON FROM property = 'qty', desc = TRUE);
        ORDERS uofItems.i TO uofOrders;
    };
    assertEquals(STRING(uofOrders()), STRING(JSON(r'[{"property": "qty", "desc": true}]')), 'ORDERS read ' + STRING(uofOrders()));
}

testFilterReadBack 'FILTERS right after FILTER reads the filters it set' () {
    SHOW uofItems NOWAIT {
        FILTER uofItems.i FROM (JSON FROM property = 'qty', compare = '>', value = 2);
        FILTERS uofItems.i TO uofFilters;
    };
    // FILTERS writes the value as a string
    assertEquals(STRING(uofFilters()), STRING(JSON(r'[{"property": "qty", "compare": ">", "negation": false, "value": "2"}]')),
                 'FILTERS read ' + STRING(uofFilters()));
}

testFilterTakesBackFilters 'FILTER takes back what FILTERS wrote' () {
    SHOW uofItems NOWAIT {
        FILTER uofItems.i FROM (JSON FROM property = 'qty', compare = '>', value = 2);
        FILTERS uofItems.i TO uofFilters;
        // the value FILTERS wrote as a string is parsed as a string - a number does not parse from a JSON string
        FILTER uofItems.i FROM uofFilters();
        FILTERS uofItems.i TO uofFiltersAgain;
    };
    assertEquals(STRING(uofFiltersAgain()), STRING(uofFilters()), 'FILTERS read ' + STRING(uofFiltersAgain()) + ' after FILTER of ' + STRING(uofFilters()));
}

// JSON given by a literal is a raw literal (FILTER_ORDER_operators.md): in a plain one {...} is a localization
// identifier, replaced, with no translation, by itself without the braces - no JSON any more (and one with a space
// inside the braces does not compile at all)
testOrderFromRawLiteral 'ORDER takes JSON given by a raw literal, which a plain literal is not' () {
    assertEquals(STRING('[{"property":"qty"}]'), r'["property":"qty"]', 'a plain literal kept its braces');
    SHOW uofItems NOWAIT {
        ORDER uofItems.i FROM JSON(r'[{"property": "qty", "desc": true}]');
        ORDERS uofItems.i TO uofOrders;
    };
    assertEquals(STRING(uofOrders()), STRING(JSON(r'[{"property": "qty", "desc": true}]')), 'ORDERS read ' + STRING(uofOrders()));
}

uofName 'Name' = DATA STRING[20] (UofItem);
uofCurrent = DATA LOCAL UofItem ();
uofOrderEvents = DATA LOCAL INTEGER ();

// ON ORDER fires while the form reads its changes, before it reads the group's rows: the rows are read with the orders
// the handler leaves. The reading used to take them before the handler ran, and the rows came in the old ones
FORM uofOrdered 'Items a handler orders'
    OBJECTS i = UofItem
    PROPERTIES(i) READONLY name = uofName, qty = uofQty
    ORDERS name
    EVENTS
        ON ORDER i {
            uofOrderEvents() <- uofOrderEvents() (+) 1;
            ORDER uofOrdered.i FROM JSON(r'[{"property": "qty", "desc": true}]');
        },
        ON CHANGE i { uofCurrent() <- i; }
;

testOrderOfAnOrderHandlerIsRead 'An ORDER of ON ORDER is what the rows are read with, and ON ORDER does not fire for it' () {
    NEW a = UofItem { uofName(a) <- 'A'; uofQty(a) <- 1; }
    NEW b = UofItem { uofName(b) <- 'B'; uofQty(b) <- 5; }
    NEW c = UofItem { uofName(c) <- 'C'; uofQty(c) <- 9; }
    SHOW uofOrdered NOWAIT;
    // A is the first row by name, C - by the handler's order, qty descending
    assertEquals(uofName(uofCurrent()), 'C', 'the current object is ' + uofName(uofCurrent()) + ', not C, the first row of the handler\'s order');
    assertEquals(uofOrderEvents(), 1, 'ON ORDER fired ' + uofOrderEvents() + ' times');
}

uofFirstOrdered = DATA LOCAL UofItem ();

FORM uofOrderRead 'Items whose ON ORDER reads their orders'
    OBJECTS i = UofItem
    PROPERTIES(i) READONLY name = uofName, qty = uofQty
    ORDERS qty DESC
;

uofOrderOf = ORDER uofOrderRead.i;

EXTEND FORM uofOrderRead
    EVENTS ON ORDER i {
        FOR UofItem x IS UofItem ORDER uofOrderOf(x) DO {
            uofFirstOrdered() <- x;
            BREAK;
        }
    }
;

testOrderHandlerReadsTheOrderProperty 'ON ORDER reads the ORDER property of the orders it fires for' () {
    NEW a = UofItem { uofName(a) <- 'A'; uofQty(a) <- 1; }
    NEW b = UofItem { uofName(b) <- 'B'; uofQty(b) <- 5; }
    NEW c = UofItem { uofName(c) <- 'C'; uofQty(c) <- 9; }
    SHOW uofOrderRead NOWAIT;
    // C, qty 9, is the first by qty descending
    assertEquals(uofName(uofFirstOrdered()), 'C', 'ON ORDER read ' + uofName(uofFirstOrdered()) + ' first by the ORDER property, not C');
}

uofAPasses = DATA LOCAL BOOLEAN ();
uofNamed (STRING[20] name) = GROUP AGGR UofItem i BY uofName(i);

FORM uofOrderFiltered 'Items a handler filters as they are ordered'
    OBJECTS i = UofItem
    PROPERTIES(i) READONLY name = uofName, qty = uofQty
    ORDERS name
;

uofPasses = FILTER uofOrderFiltered.i;

EXTEND FORM uofOrderFiltered
    EVENTS
        ON ORDER i { FILTER uofOrderFiltered.i FROM JSON(r'[{"property": "qty", "compare": ">", "value": 2}]'); },
        // the current object changes after the rows are read
        ON CHANGE i { uofAPasses() <- uofPasses(uofNamed('A')); }
;

testFilterOfAnOrderHandlerIsTheGroupsFilter 'A FILTER of ON ORDER is what the FILTER property of the group gives' () {
    NEW a = UofItem { uofName(a) <- 'A'; uofQty(a) <- 1; }
    NEW b = UofItem { uofName(b) <- 'B'; uofQty(b) <- 5; }
    NEW c = UofItem { uofName(c) <- 'C'; uofQty(c) <- 9; }
    SHOW uofOrderFiltered NOWAIT;
    // A, qty 1, does not pass the handler's filter, qty > 2
    assertNull(uofAPasses(), 'FILTER of the group passes A, which the handler\'s filter does not');
}
