MODULE KeyBindings;

REQUIRE TestUtils;

// a property of a form keeps the keys bound to it (ON KEYPRESS in its options). Modules that do not require each other
// are parsed at once, each in a thread of its own, so two of them that bind keys to one property of a form (EXTEND
// PROPERTIES) put them into its bindings at once: they went into a plain map, which two puts at once corrupt - one of
// the bindings could be lost

kbName = DATA LOCAL STRING ();

kbFailure = DATA LOCAL STRING ();
kbBindAtOnce INTERNAL 'lsfusion.tests.BindKeysAtOnceAction' ();

testKeysBoundAtOnce 'Keys two threads bind to one property at once are both kept' () {
    kbBindAtOnce();
    assertNull(kbFailure(), kbFailure());
}

// ... and a form built from another one (FORMS) has the keys bound to the other's properties : they were not copied
kbKeyed () { MESSAGE 'kb keyed'; }

FORM kbBound 'Bound keys'
    PROPERTIES bound = kbName() ON KEYPRESS 'F7' kbKeyed()
;

FORM kbBuilt 'Built from bound keys'
    FORMS kbBound
;

kbBuiltBinding = DATA LOCAL STRING ();
kbReadBuiltBinding INTERNAL 'lsfusion.tests.ReadBuiltKeyBindingAction' ();

testKeysOfBuiltForm 'A form built from another one has the keys bound to its properties' () {
    kbReadBuiltBinding();
    assertNull(kbBuiltBinding(), kbBuiltBinding());
}
