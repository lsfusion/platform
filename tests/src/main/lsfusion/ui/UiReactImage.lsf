MODULE UiReactImage;

REQUIRE SystemEvents;

// the values UiReactImageIT reads from a React view (UiReactImage.js), each case on its own form
CLASS uiRiItem;
uiRiShown = DATA BOOLEAN (uiRiItem);
uiRiIcon (uiRiItem r) = 'bi bi-plus';

// a string footer of a property named image is text, while its cells name images
FORM uiRiFooter 'React image footer'
    OBJECTS r = uiRiItem
    PROPERTIES(r) image = uiRiIcon FOOTER 'footer text'
    FILTERS uiRiShown(r)
;
DESIGN uiRiFooter {
    NEW uiRiBoard FIRST { custom = 'UiReactImageBoard'; MOVE BOX(r); }
}

CLASS uiRiStatus;
uiRiStatusName = DATA STRING[100] (uiRiStatus);
uiRiStatusOf = DATA uiRiStatus (uiRiItem);
uiRiNameStatus (uiRiItem r) = uiRiStatusName(uiRiStatusOf(r));

// a SELECT named image is given as options, whoever draws it
FORM uiRiSelect 'React image select'
    OBJECTS r = uiRiItem
    PROPERTIES(r) image = uiRiNameStatus SELECT
    FILTERS uiRiShown(r)
;
DESIGN uiRiSelect {
    NEW uiRiBoard FIRST { custom = 'UiReactImageBoard'; MOVE BOX(r); }
}

FORM uiRiPlatformSelect 'Platform image select'
    OBJECTS r = uiRiItem
    PROPERTIES(r) image = uiRiNameStatus SELECT 'dropdown' NOCUSTOM
    FILTERS uiRiShown(r)
;

// icon classes keep quotes as text when the image's HTML is parsed
uiRiClasses () = 'bi-x" onmouseover="injected';
FORM uiRiIconClasses 'React image icon classes'
    PROPERTIES() image = uiRiClasses
;
DESIGN uiRiIconClasses {
    NEW uiRiBoard FIRST { custom = 'UiReactImageBoard'; MOVE PROPERTY(image); }
}

// an external image keeps its URL, including entities and quotes, when its HTML is parsed
uiRiURL () = 'hTtPs://example.invalid/ui-ri.png?size=2;theme=dark&copy;=b" onerror="injected#image';
FORM uiRiUrl 'React image URL'
    PROPERTIES() image = uiRiURL
;
DESIGN uiRiUrl {
    NEW uiRiBoard FIRST { custom = 'UiReactImageBoard'; MOVE PROPERTY(image); }
}

uiRiSeed (STRING[50] name) {
    uiRiShown(uiRiItem r) <- NULL;
    NEW s = uiRiStatus {
        uiRiStatusName(s) <- 'New ' + name;
        NEW r = uiRiItem { uiRiShown(r) <- TRUE; uiRiStatusOf(r) <- s; }
    }
    NEW s = uiRiStatus { uiRiStatusName(s) <- 'Done ' + name; }
    APPLY;
}

NAVIGATOR {
    NEW FOLDER uiRiFolder 'UI React image' WINDOW toolbar {
        NEW uiRiFooter;
        NEW uiRiSelect;
        NEW uiRiPlatformSelect;
        NEW uiRiIconClasses;
        NEW uiRiUrl;
    }
}

onWebClientInit() + {
    onWebClientInit('UiReactImage.js') <- 1;
}
