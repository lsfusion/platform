MODULE UiConnectionCustomize;

REQUIRE SystemEvents, Service, TestUtils;

FORM uiCcForm 'UI connection customize: form';
FORM uiCcOther 'UI connection customize: other';

// what the code written in the editor adds to the form
uiCcAdded 'Added by the code' = DATA LOCAL STRING[20] ();

NAVIGATOR {
    NEW FOLDER uiConnectionCustomize 'UI connection customize' WINDOW toolbar {
        NEW uiCcForm;
        NEW uiCcOther;
    }
}

// what the codes of the tests name of the page - the components that draw a window and lay the windows out, and the
// function what a code schedules calls (UiConnectionCustomize.js) : a code brings no page code of its own
onWebClientInit() + {
    onWebClientInit('UiConnectionCustomize.js') <- 1;
}

// a form opened over an item as it is added, before it is saved : NEW gives the form an object it has no Cancel for.
// Given none, the form shows the first item
CLASS UiCcItem 'UI connection customize: item';
uiCcItemName 'Name' = DATA STRING[20] (UiCcItem);

FORM uiCcItem 'UI connection customize: item'
    OBJECTS i = UiCcItem PANEL FIRST
    PROPERTIES(i) uiCcItemName
;
// what the code written in the editor adds to that form the second time
uiCcAgain 'Added again' = DATA LOCAL STRING[20] ();

uiCcNewItem 'New item' () {
    NEWSESSION {
        NEW i = UiCcItem {
            uiCcItemName(i) <- 'unsaved';
            SHOW uiCcItem OBJECTS i = i DOCKED;
        }
    }
}

NAVIGATOR {
    uiConnectionCustomize {
        NEW uiCcNewItem;
    }
}

// the form of the item shown as a popup, as a property's editor is
uiCcPopupItem 'Item in a popup' () {
    SHOW uiCcItem POPUP;
}
EXTEND FORM uiCcOther PROPERTIES() uiCcPopupItem;

// an item saved before : a form that lost its object shows this one
uiCcSaveItem (STRING name) {
    NEWSESSION {
        NEW i = UiCcItem {
            uiCcItemName(i) <- name;
        }
        APPLY;
    }
}

uiCcCheckItems (STRING expected) {
    LOCAL names = TEXT ();
    names() <- GROUP CONCAT uiCcItemName(UiCcItem i), ',' ORDER i;
    assertEquals(names(), expected, CONCAT ' ', 'the items saved are', names(), 'not', expected);
}

// the code for all users, so that it does not matter which user the browser is
uiCcSet (TEXT code) {
    dataExtendCode() <- code;
    APPLY;
}
// a code that does not compile is refused when it is saved, so one saved before that, or broken since by a change of the
// logics, is stored past the refusal
uiCcSetBroken (TEXT code) {
    setNoCancelInTransaction();
    uiCcSet(code);
    dropNoCancelInTransaction();
}

// the code of a form, for all users as well
uiCcSetForm (STRING name, TEXT code) {
    dataExtendCode(form(name)) <- code;
    APPLY;
}

// evaluates a script that names what only the code of the application's customization declares
uiCcEvaluate 'Evaluate' () { EVAL ACTION 'uiCcSay();'; }
EXTEND FORM uiCcOther PROPERTIES() uiCcEvaluate;

// an action and a property the code of a test declares under the same names : called by the bare name, each is
// neither; with the namespace, this one
uiCcLogics (INTEGER a) { RETURN a; }
uiCcLogicsNote = DATA LOCAL STRING[20] ();

// the test sets the setting and restores it through /exec, with no login
uiCcEnableAPI (STRING value) {
    Service.baseValue(setting('enableAPI')) <- value;
    APPLY;
} @@noauth;

// with what the editor saved for a user : the browser's user is not known here. And the items a test saved
uiCcReset () {
    dataExtendCode() <- NULL;
    dataExtendCode(User u) <- NULL WHERE u IS User;
    dataExtendCode(form('UiConnectionCustomize.uiCcForm'), User u) <- NULL WHERE u IS User;
    dataExtendCode(form('UiConnectionCustomize.uiCcForm')) <- NULL;
    dataExtendCode(form('UiConnectionCustomize.uiCcItem'), User u) <- NULL WHERE u IS User;
    dataExtendCode(form('UiCustomView.uiCustomViewCalls')) <- NULL;
    DELETE UiCcItem i WHERE i IS UiCcItem;
    APPLY;
}
