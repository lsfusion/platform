MODULE UiGrid;

REQUIRE TestUtils, Utils, SystemEvents;

// the grids UiGridIT works on in the browser, the render function it draws one with (UiGrid.js), and the actions it
// seeds and checks its item with

CLASS UiGridItem 'Item';
uiGridName 'Name' = DATA STRING[50] (UiGridItem);
uiGridQuantity 'Quantity' = DATA INTEGER (UiGridItem);
uiGridItem (STRING[50] name) = GROUP AGGR UiGridItem i BY uiGridName(i);

FORM uiGridItems 'Items'
    OBJECTS i = UiGridItem
    PROPERTIES(i) uiGridName, uiGridQuantity
;

// a column of images, whose footer, an image too, the grid draws as it draws the column's cells
uiGridPicture 'Picture' = DATA IMAGEFILE (UiGridItem);

FORM uiGridPictures 'Pictures'
    OBJECTS i = UiGridItem
    PROPERTIES(i) READONLY uiGridPicture FOOTER IMAGEFILE(FILE('a footer'))
;

// a column of images whose footers are of other types - a text file, a string, a link to an image, a logical -, and a
// column of logicals with a string footer, which the grid draws as values of their own types
uiGridPhoto 'Photo' = DATA IMAGEFILE (UiGridItem);
uiGridChecked 'Checked' = DATA BOOLEAN (UiGridItem);

FORM uiGridFooters 'Footers'
    OBJECTS i = UiGridItem
    PROPERTIES(i) READONLY uiGridPhoto FOOTER TEXTFILE('a text footer'), uiGridPhotoTotal = uiGridPhoto FOOTER 'a string footer',
                           uiGridPhotoLink = uiGridPhoto FOOTER IMAGELINK('a-link-footer.png'), uiGridPhotoChecked = uiGridPhoto FOOTER TRUE,
                           uiGridChecked FOOTER 'a footer of checks'
;

// columns with a PATTERN - dates in an order no locale writes them in, numbers with leading zeros - whose footers are of
// another kind of type - a whole number, as a count is, under each -, which the grid formats by their own types, or of the
// column's kind - a date under the dates, a number under the numbers -, which it formats by the column's pattern
uiGridDate 'Date' = DATA DATE (UiGridItem) PATTERN 'yyyy.dd.MM';
uiGridNumber 'Number' = DATA NUMERIC[10,2] (UiGridItem) PATTERN '000000';

FORM uiGridPatterns 'Patterns'
    OBJECTS i = UiGridItem
    PROPERTIES(i) READONLY uiGridDate FOOTER 42, uiGridDateDue = uiGridDate FOOTER 2031_12_31,
                           uiGridNumber FOOTER 42, uiGridNumberTotal = uiGridNumber FOOTER 7.0
;

// a column a render function draws (uiGridHtml), of a property named image, whose cells name an image each and whose
// string footer is a text
uiGridIcon (UiGridItem i) = 'bi bi-plus';

FORM uiGridIcons 'Icons'
    OBJECTS i = UiGridItem
    PROPERTIES(i) READONLY image = uiGridIcon CUSTOM 'uiGridHtml' FOOTER 'a string footer of icons'
;

// the lines a table selects - those of the test that seeded last, numbered from 1 -, and what the form reads of the
// selection: how many rows SELECT returns, the current one while none is selected, and the columns it reads as selected
CLASS UiGridLine 'Line';
uiGridLineNumber 'Number' = DATA INTEGER (UiGridLine);
uiGridLineName 'Name' = DATA STRING[50] (UiGridLine);
uiGridLineQuantity 'Quantity' = DATA INTEGER (UiGridLine);
uiGridLineShown = DATA BOOLEAN (UiGridLine);

FORM uiGridSelection 'Selection'
    OBJECTS l = UiGridLine
    PROPERTIES(l) READONLY number = uiGridLineNumber
    PROPERTIES(l) name = uiGridLineName, qty = uiGridLineQuantity
    FILTERS uiGridLineShown(l)
    ORDERS number
;
uiGridSelected () = GROUP SUM 1 IF [ SELECT uiGridSelection.l](UiGridLine l);
uiGridNameSelected () = [ SELECT PROPERTY uiGridSelection.name]();
uiGridQtySelected () = [ SELECT PROPERTY uiGridSelection.qty]();

EXTEND FORM uiGridSelection
    PROPERTIES() selectedCount = uiGridSelected, nameSelected = uiGridNameSelected, qtySelected = uiGridQtySelected
;

NAVIGATOR {
    NEW FOLDER uiGrid 'UI grid' WINDOW toolbar {
        NEW uiGridItems;
        NEW uiGridSelection;
        NEW uiGridPictures;
        NEW uiGridFooters;
        NEW uiGridPatterns;
        NEW uiGridIcons;
    }
}

onWebClientInit() + {
    onWebClientInit('UiGrid.js') <- 1;
}

uiGridSeed (STRING[50] name) {
    NEW i = UiGridItem {
        uiGridName(i) <- name;
    }
    APPLY;
}

uiGridSeedLines (INTEGER count) {
    uiGridLineShown(UiGridLine l) <- NULL;
    FOR iterate(INTEGER k, 1, count) DO NEW l = UiGridLine {
        uiGridLineNumber(l) <- k;
        uiGridLineName(l) <- 'line ' + k;
        uiGridLineQuantity(l) <- k;
        uiGridLineShown(l) <- TRUE;
    }
    APPLY;
}

uiGridCheckQuantity (STRING[50] name, INTEGER expected) {
    assertEquals(uiGridQuantity(uiGridItem(name)), expected, CONCAT ' ', 'the quantity of', name, 'is', uiGridQuantity(uiGridItem(name)), 'not', expected);
}
