MODULE UiWebMCP;

REQUIRE TestUtils, SystemEvents, Reflection;

// what the scripts of UiWebMCPIT read and change, in the form's session or in a session of the navigator

uiWebMCPNote 'Note' = DATA STRING[100] ();

FORM uiWebMCP 'WebMCP'
    PROPERTIES() uiWebMCPNote
;

// what a script is run in by an address: another form, and the first one opened again under a label
FORM uiWebMCPOther 'WebMCP other'
    PROPERTIES() uiWebMCPNote
;
uiWebMCPLabelled 'WebMCP labelled' () { SHOW 'labelled' = uiWebMCP NOWAIT NEWSESSION; }

// what the methods of a form are called on: a list of items with a filter group, an action of a row, and their tree
CLASS UiWebMCPItem 'Item';
uiWebMCPName 'Name' = DATA STRING[50] (UiWebMCPItem);
uiWebMCPQuantity 'Quantity' = DATA INTEGER (UiWebMCPItem);
uiWebMCPDate 'Date' = DATA DATE (UiWebMCPItem);
uiWebMCPParent 'Parent' = DATA UiWebMCPItem (UiWebMCPItem);
uiWebMCPTouch 'Touch' (UiWebMCPItem i) { uiWebMCPNote() <- 'touched ' + uiWebMCPName(i); }
// ... and one the server fails
uiWebMCPCrash 'Crash' INTERNAL <{ if (true) throw new Error("uiWebMCPCrash: the action failed"); }>;

FORM uiWebMCPItems 'WebMCP items'
    PROPERTIES() uiWebMCPNote, uiWebMCPCrash
    OBJECTS i = UiWebMCPItem
    PROPERTIES(i) name = uiWebMCPName, quantity = uiWebMCPQuantity, date = uiWebMCPDate, touch = uiWebMCPTouch
    FILTERGROUP many
        FILTER 'Many' uiWebMCPQuantity(i) > 10

    TREE items t = UiWebMCPItem PARENT uiWebMCPParent(t)
    PROPERTIES(t) READONLY node = uiWebMCPName
;

NAVIGATOR {
    NEW FOLDER uiWebMCPFolder 'UI WebMCP' WINDOW toolbar {
        NEW uiWebMCP;
        NEW uiWebMCPOther;
        NEW uiWebMCPLabelled;
        NEW uiWebMCPItems;
    }
}

// a property with a parameter: a script that returns it with the parameter left free answers with every value
uiWebMCPMark 'Mark' = DATA INTEGER (STRING[10]);

// actions of the logic that a tool runs by name: one of a parameter, one that reads what a session holds
uiWebMCPDouble 'Double' (INTEGER x) { RETURN x * 2; }
uiWebMCPReadNote 'Read the note' () { RETURN uiWebMCPNote(); }

uiWebMCPSeed (STRING[100] note) {
    uiWebMCPNote() <- note;
    uiWebMCPMark('first') <- 1;
    uiWebMCPMark('second') <- 2;
    APPLY;
}

// three items: `a` with `c` under it, and `b`
uiWebMCPSeedItems () {
    DELETE UiWebMCPItem i WHERE i IS UiWebMCPItem;
    NEW a = UiWebMCPItem {
        uiWebMCPName(a) <- 'a'; uiWebMCPQuantity(a) <- 5; uiWebMCPDate(a) <- 2026_01_10;
        NEW c = UiWebMCPItem {
            uiWebMCPName(c) <- 'c'; uiWebMCPQuantity(c) <- 30; uiWebMCPDate(c) <- 2026_03_10; uiWebMCPParent(c) <- a;
        }
    }
    NEW b = UiWebMCPItem {
        uiWebMCPName(b) <- 'b'; uiWebMCPQuantity(b) <- 20; uiWebMCPDate(b) <- 2026_02_10;
    }
    uiWebMCPNote() <- NULL;
    APPLY;
}

uiWebMCPExtra 'Extra' = DATA STRING[100] ();

uiWebMCPDropCustomization () {
    dataExtendCode(form('UiWebMCP.uiWebMCP'), User u) <- NULL WHERE dataExtendCode(form('UiWebMCP.uiWebMCP'), u);
    dataExtendCode(User u) <- NULL WHERE dataExtendCode(u);
    APPLY;
}
