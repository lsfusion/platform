MODULE UiReactViewFilters;

REQUIRE System, Utils, SystemEvents;

// the form UiReactViewFiltersIT works on in the browser - the rows of a group a React view (UiReactViewFilters.js)
// draws, which states view filters of its own for them -, and the action it seeds the items with

CLASS UiReactViewFiltersItem 'Item';
uiReactViewFiltersNumber 'Number' = DATA INTEGER (UiReactViewFiltersItem);
uiReactViewFiltersShown = DATA BOOLEAN (UiReactViewFiltersItem); // the items of the test that seeded last: the form shows only them

FORM uiReactViewFilters 'React view filters'
    OBJECTS i = UiReactViewFiltersItem
    PROPERTIES(i) READONLY number = uiReactViewFiltersNumber
    FILTERS uiReactViewFiltersShown(i)
    ORDERS number
;

DESIGN uiReactViewFilters {
    BOX(i) { custom = r'UiReactViewFilters'; }
}

onWebClientInit() + { onWebClientInit(r'UiReactViewFilters.js') <- 1; }

NAVIGATOR {
    NEW FOLDER uiReactViewFiltersFolder 'UI React view filters' WINDOW toolbar { NEW uiReactViewFilters; }
}

// the items shown from now on, numbered 1 to n
uiReactViewFiltersSeed (INTEGER n) {
    uiReactViewFiltersShown(UiReactViewFiltersItem i) <- NULL;
    FOR iterate(INTEGER k, 1, n) DO NEW i = UiReactViewFiltersItem {
        uiReactViewFiltersNumber(i) <- k;
        uiReactViewFiltersShown(i) <- TRUE;
    }
    APPLY;
}
