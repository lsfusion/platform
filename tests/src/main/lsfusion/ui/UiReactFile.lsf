MODULE UiReactFile;

REQUIRE SystemEvents;

// the files UiReactFileIT has a React view (UiReactFile.js) given - the values of its properties and what its calls to
// the server return - and fetches the links of

// files of the classes whose value the server sends as an image made of the file
uiRfPdf 'PDF' () = PDFFILE(FILE('a PDF'));
uiRfVideo 'Video' () = VIDEOFILE(FILE('a video'));
uiRfImage 'Image' () = IMAGEFILE(FILE('an image'));

// ... of another class, whose value the server sends to a React view as the file itself, saved
uiRfText 'Text' () = TEXTFILE('a text');

// ... and a column of files, whose footer, given on the form, the server sends to a React view as the file itself too,
// and a column of images, whose footer it sends as an image made of the file, as an image's value
CLASS uiRfItem { one }
uiRfFile 'File' = DATA TEXTFILE (uiRfItem);
uiRfPicture 'Picture' = DATA IMAGEFILE (uiRfItem);

// a string drawn as a property named image, which the server sends to a React view as the image it names, as to a
// classic custom view
uiRfNamedImage 'Named image' () = 'bi bi-plus';

// ... and what a call returns, which the server sends as the file itself, saved
uiRfPdfResult () { RETURN uiRfPdf(); }
uiRfImageResult () { RETURN uiRfImage(); }

FORM uiRfForm 'React files'
    PROPERTIES() uiRfPdf, uiRfVideo, uiRfImage, uiRfText
    PROPERTIES() image = uiRfNamedImage
    OBJECTS r = uiRfItem
    PROPERTIES(r) READONLY uiRfFile FOOTER TEXTFILE('a footer'), uiRfPicture FOOTER IMAGEFILE(FILE('an image footer'))
    CUSTOMS uiRfPdfResult, uiRfImageResult
;

DESIGN uiRfForm {
    NEW uiRfBoard FIRST {
        custom = 'UiReactFileBoard';
        MOVE PROPERTY(uiRfPdf());
        MOVE PROPERTY(uiRfVideo());
        MOVE PROPERTY(uiRfImage());
        MOVE PROPERTY(uiRfText());
        MOVE PROPERTY(image);
        MOVE BOX(r);
    }
}

NAVIGATOR {
    NEW FOLDER uiReactFile 'UI React file' WINDOW toolbar {
        NEW uiRfForm;
    }
}

onWebClientInit() + {
    onWebClientInit('UiReactFile.js') <- 1;
}
