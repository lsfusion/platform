MODULE UiCustomView;

REQUIRE TestUtils, SystemEvents;

// the forms UiCustomViewIT works on in the browser - React views (UiCustomView.js) that place what the platform draws,
// change what they draw through their members and call the server through their controller, a custom cell renderer,
// the React components a property's and a group's CUSTOM name, and the JS functions INTERNAL CLIENT actions of a form
// and of the navigator run with a controller -, and the actions it seeds the items with and checks what was stored by

CLASS UiCustomViewItem 'Item';
uiCustomViewName 'Name' = DATA STRING[50] (UiCustomViewItem);
uiCustomViewQuantity 'Quantity' = DATA INTEGER (UiCustomViewItem);
// the items of the test that seeded last: the forms show only them
uiCustomViewShown = DATA BOOLEAN (UiCustomViewItem);

// a view that draws the rows itself and places the platform's editor of the quantity in each (UiCustomViewRows)
FORM uiCustomViewRows 'Rows'
    OBJECTS i = UiCustomViewItem
    PROPERTIES(i) READONLY uiCustomViewName
    PROPERTIES(i) uiCustomViewQuantity NOCUSTOM
    FILTERS uiCustomViewShown(i)
    ORDERS uiCustomViewName(i)
;

DESIGN uiCustomViewRows {
    NEW rows FIRST {
        custom = 'UiCustomViewRows';
        MOVE BOX(i);
    }
}

// a view that places the note the platform draws twice, the first time in a node it never puts in the page
// (UiCustomViewStray)
uiCustomViewNote 'Note' = DATA LOCAL STRING[50] ();

FORM uiCustomViewStray 'Stray place'
    PROPERTIES() uiCustomViewNote NOCUSTOM
;

DESIGN uiCustomViewStray {
    NEW stray FIRST {
        custom = 'UiCustomViewStray';
        MOVE PROPERTY(uiCustomViewNote());
    }
}

// a view that draws the rows and the quantities itself, and changes a quantity through its member
// (UiCustomViewQuantities)
FORM uiCustomViewQuantities 'Quantities'
    OBJECTS i = UiCustomViewItem
    PROPERTIES(i) READONLY uiCustomViewName
    PROPERTIES(i) uiCustomViewQuantity
    FILTERS uiCustomViewShown(i)
    ORDERS uiCustomViewName(i)
;

DESIGN uiCustomViewQuantities {
    NEW quantities FIRST {
        custom = 'UiCustomViewQuantities';
        MOVE BOX(i);
    }
}

// what a view's calls to the server change and read, in the form's session (UiCustomViewCalls); the platform draws it
uiCustomViewCount 'Count' = DATA LOCAL INTEGER ();
uiCustomViewDouble (INTEGER a) {
    RETURN a * 2;
}
// an action that may close the form, whose close the client foresees all the same, taking the form off the page until
// the server answers: the server refuses it while the form is to be kept, and only stops keeping it
uiCustomViewKeep = DATA LOCAL BOOLEAN ();
uiCustomViewTryClose 'Try to close' () {
    IF uiCustomViewKeep() THEN
        uiCustomViewKeep() <- NULL;
    ELSE
        formClose();
}
// ... and one that closes it, which the view calls through its member
uiCustomViewClose 'Close' () {
    formClose();
}

FORM uiCustomViewCalls 'Calls'
    PROPERTIES() READONLY uiCustomViewCount
    PROPERTIES() uiCustomViewTryClose, uiCustomViewClose
    CUSTOMS uiCustomViewDouble, uiCustomViewCount
;

DESIGN uiCustomViewCalls {
    NEW calls FIRST {
        custom = 'UiCustomViewCalls';
        MOVE PROPERTY(uiCustomViewClose());
    }
}

// INTERNAL CLIENT actions, each given 21 and the form's controller: a JS function whose answer the action takes, and
// an asynchronous one, which changes the answer through the controller, in the form's session - followed in its action
// by a JS function that notes, in the page, whether the change was over when it ran. The action waits for neither, so
// that the server takes the change while it is not waiting for the client
uiCustomViewAnswer 'Answer' = DATA LOCAL STRING[100] ();
uiCustomViewOnClient 'On the client' () {
    INTERNAL CLIENT 'uiCustomViewOnClient' PARAMS 21 TO uiCustomViewAnswer;
}
uiCustomViewThroughServer 'Through the server' () {
    INTERNAL CLIENT 'uiCustomViewThroughServer' PARAMS 21;
    INTERNAL CLIENT 'uiCustomViewAfterServer';
}

FORM uiCustomViewClient 'Client'
    PROPERTIES() READONLY uiCustomViewAnswer
    PROPERTIES() uiCustomViewOnClient, uiCustomViewThroughServer
    CUSTOMS uiCustomViewAnswer
;

// a property a custom cell renderer draws (UiCustomViewCell - a classic render function named as a component is), which
// changes it through its controller and calls the server through the form's controller it reaches from there; the
// platform draws what the server has of it
uiCustomViewCellText 'Cell text' = DATA LOCAL STRING[50] ();
uiCustomViewCellEcho 'Echo' () = uiCustomViewCellText();

FORM uiCustomViewCell 'Cell'
    PROPERTIES() uiCustomViewCellText CUSTOM 'UiCustomViewCell'
    PROPERTIES() READONLY uiCustomViewCellEcho
    CUSTOMS uiCustomViewDouble
;

// properties whose CUSTOM is a React component (UiCustomViewReactCell), which the platform draws with it: the quantity
// in the grid - read-only for the item of quantity 1 until the count is set, and hidden by the toggle -, the quantity
// of the current item on the panel, and the count, a property of no group
uiCustomViewHideCells = DATA LOCAL BOOLEAN ();
uiCustomViewShowCells () = NOT uiCustomViewHideCells();
uiCustomViewToggleCells 'Toggle cells' () { uiCustomViewHideCells() <- NOT uiCustomViewHideCells(); }
uiCustomViewReadOnlyCell (UiCustomViewItem i) = uiCustomViewQuantity(i) = 1 AND NOT (uiCustomViewCount() > 0);
uiCustomViewCountEcho 'Count echo' () = uiCustomViewCount();

FORM uiCustomViewReactCells 'React cells'
    OBJECTS i = UiCustomViewItem
    PROPERTIES(i) READONLY uiCustomViewName
    PROPERTIES(i) uiCustomViewQuantity CUSTOM 'UiCustomViewReactCell' SHOWIF uiCustomViewShowCells() READONLYIF uiCustomViewReadOnlyCell(i)
    PROPERTIES(i) PANEL panelQuantity = uiCustomViewQuantity CUSTOM 'UiCustomViewReactCell'
    PROPERTIES() uiCustomViewCount CUSTOM 'UiCustomViewReactCell'
    PROPERTIES() READONLY uiCustomViewCountEcho
    PROPERTIES() uiCustomViewToggleCells
    FILTERS uiCustomViewShown(i)
    ORDERS uiCustomViewName(i)
;

// a group whose CUSTOM is a React component (UiCustomViewCards), given the group's rows, its OPTIONS and the classic
// controller of a custom view of them
uiCustomViewCardsOptions () = JSON FROM title = 'Cards';

FORM uiCustomViewReactGroup 'React group'
    OBJECTS i = UiCustomViewItem CUSTOM 'UiCustomViewCards' OPTIONS uiCustomViewCardsOptions()
    PROPERTIES(i) READONLY uiCustomViewName
    PROPERTIES(i) uiCustomViewQuantity
    FILTERS uiCustomViewShown(i)
    ORDERS uiCustomViewName(i)
;

// ... and the same group inside a React container (UiCustomViewCardsOuter): its grid stays the platform's, in its
// CUSTOM view, and the container places it
FORM uiCustomViewPlacedGroup 'Placed React group'
    OBJECTS i = UiCustomViewItem CUSTOM 'UiCustomViewCards' OPTIONS uiCustomViewCardsOptions()
    PROPERTIES(i) READONLY uiCustomViewName
    PROPERTIES(i) uiCustomViewQuantity
    FILTERS uiCustomViewShown(i)
    ORDERS uiCustomViewName(i)
;

DESIGN uiCustomViewPlacedGroup {
    NEW cards FIRST {
        custom = 'UiCustomViewCardsOuter';
        MOVE GRID(i);
    }
}

// a React view of the grid that draws the rows and places in each what the platform draws of it - the quantity with
// the React component its CUSTOM names, and with the platform's own editor (NOCUSTOM) -, in a React container that
// places the grid and the quantity of the current item, which the platform draws with the same component
FORM uiCustomViewPlacedProperties 'Placed custom properties'
    OBJECTS i = UiCustomViewItem
    PROPERTIES(i) READONLY uiCustomViewName
    PROPERTIES(i) uiCustomViewQuantity CUSTOM 'UiCustomViewReactCell'
    PROPERTIES(i) standardQuantity = uiCustomViewQuantity NOCUSTOM
    PROPERTIES(i) PANEL panelQuantity = uiCustomViewQuantity CUSTOM 'UiCustomViewReactCell'
    FILTERS uiCustomViewShown(i)
    ORDERS uiCustomViewName(i)
;

DESIGN uiCustomViewPlacedProperties {
    NEW cards FIRST {
        custom = 'UiCustomViewPlacedOuter';
        MOVE GRID(i) { custom = 'UiCustomViewPlacedGrid'; }
        MOVE PROPERTY(panelQuantity);
    }
}

// a group whose CUSTOM is a classic render function named as a component is (UiCustomViewClassicGroup); its first
// property has a background and is hidden by the toggle
FORM uiCustomViewClassicGroup 'Classic group'
    OBJECTS i = UiCustomViewItem CUSTOM 'UiCustomViewClassicGroup'
    PROPERTIES(i) READONLY mark = uiCustomViewName BACKGROUND RGB(255, 0, 0) SHOWIF uiCustomViewShowCells()
    PROPERTIES(i) READONLY uiCustomViewName
    PROPERTIES() uiCustomViewToggleCells
    FILTERS uiCustomViewShown(i)
;

// an INTERNAL CLIENT action the navigator runs, given 6 and the navigator's controller: through it, the JS function
// evaluates a script and runs an action by name, which marks what it is given, in a session of its own
uiCustomViewNavigatorMarks = DATA TEXT ();
uiCustomViewNavigatorMark (STRING mark) {
    uiCustomViewNavigatorMarks() <- CONCAT ',', uiCustomViewNavigatorMarks(), mark;
    APPLY;
}
uiCustomViewFromNavigator 'From the navigator' () {
    INTERNAL CLIENT 'uiCustomViewFromNavigator' PARAMS 6;
}

onWebClientInit() + {
    onWebClientInit('UiCustomView.js') <- 1;
}

NAVIGATOR {
    NEW FOLDER uiCustomView 'UI custom view' WINDOW toolbar {
        NEW uiCustomViewRows;
        NEW uiCustomViewStray;
        NEW uiCustomViewQuantities;
        NEW uiCustomViewCalls;
        NEW uiCustomViewClient;
        NEW uiCustomViewCell;
        NEW uiCustomViewPlacedProperties;
        NEW uiCustomViewReactGroup;
        NEW uiCustomViewPlacedGroup;
        NEW uiCustomViewClassicGroup;
        NEW uiCustomViewReactCells;
        NEW uiCustomViewFromNavigator;
    }
}

// two items shown from now on, under the names given, of the quantities 1 and 2; the navigator's marks start over
uiCustomViewSeed (STRING[50] first, STRING[50] second) {
    uiCustomViewShown(UiCustomViewItem i) <- NULL;
    uiCustomViewNavigatorMarks() <- NULL;
    NEW i = UiCustomViewItem {
        uiCustomViewName(i) <- first;
        uiCustomViewQuantity(i) <- 1;
        uiCustomViewShown(i) <- TRUE;
    }
    NEW i = UiCustomViewItem {
        uiCustomViewName(i) <- second;
        uiCustomViewQuantity(i) <- 2;
        uiCustomViewShown(i) <- TRUE;
    }
    APPLY;
}

uiCustomViewQuantityOf (STRING[50] name) =
    GROUP MAX uiCustomViewQuantity(UiCustomViewItem i) IF uiCustomViewName(i) = name;
uiCustomViewCheckQuantity (STRING[50] name, INTEGER expected) {
    assertEquals(uiCustomViewQuantityOf(name), expected, CONCAT ' ', 'the quantity of', name, 'is',
                 (OVERRIDE STRING(uiCustomViewQuantityOf(name)), 'none'), 'not', expected);
}

uiCustomViewCheckNavigatorMarks (STRING expected) {
    assertEquals((OVERRIDE uiCustomViewNavigatorMarks(), 'none'), expected,
                 CONCAT ' ', 'the marks are', (OVERRIDE uiCustomViewNavigatorMarks(), 'none'), 'not', expected);
}
