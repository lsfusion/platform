MODULE TestUtils;

REQUIRE System;

// the only way to make a test action fail : the message ends up in the http response the runner reports. NULL: a message
// names the values an assertion compared, so it is NULL when one of them is, and an INTERNAL action skips a NULL argument
fail 'Fail' (STRING message) INTERNAL 'lsfusion.tests.FailAction' (STRING) NULL;

assertTrue (BOOLEAN value, STRING message) {
    IF NOT value THEN
        fail(message);
}

assertFalse (BOOLEAN value, STRING message) {
    IF value THEN
        fail(message);
}

assertNull (value, STRING message) {
    IF value THEN
        fail(message);
}

assertNotNull (value, STRING message) {
    IF NOT value THEN
        fail(message);
}

assertEquals (a, b, STRING message) {
    IF NOT (a = b) THEN
        fail(message);
}

// whether a group of the open form the action runs in has an object in one of its rows, as of the last readShown(): the
// rows the form sends its client, read the way the form reads them before it answers it - which a form with no client
// never does. A level of a tree gets its rows under every open row of the level above, whether that one is shown or not
shownInForm = DATA LOCAL BOOLEAN (Object);
readShownRows INTERNAL 'lsfusion.tests.ReadShownAction' ();
readShown () {
    shownInForm(Object o) <- NULL;
    readShownRows();
}

// which of the server's walks of a form's design reach a component - the words of those that do: `found` (by its id),
// `read` (its readers), `sent` (its visibility), and `hidable` where a client hides it by naming it so - failing unless
// they are `walks`
assertWalked (STRING form, STRING component, STRING walks)
    INTERNAL 'lsfusion.tests.DesignWalksAction' (STRING, STRING, STRING);

// which container of a form's design a component is in, both by the names DESIGN gives them - failing unless it is
// `container`
assertPlaced (STRING form, STRING component, STRING container)
    INTERNAL 'lsfusion.tests.DesignPlacedAction' (STRING, STRING, STRING);

// the extension coefficient a component of a form's design gets, the component by the name DESIGN gives it - failing
// unless it is `flex`
assertFlex (STRING form, STRING component, INTEGER flex)
    INTERNAL 'lsfusion.tests.DesignFlexAction' (STRING, STRING, INTEGER);

// whether the open form the action runs in holds the changes of a group, by its name, back - a group in manual update
// until it is updated (forceUpdate) -, as of the last readUpdatePending() that read the form's answer to its client:
// what the client's update button and the group's dimmed rows show, which an answer that says nothing of it leaves be
updatePendingInForm = DATA LOCAL BOOLEAN (STRING);
readUpdatePending INTERNAL 'lsfusion.tests.ReadUpdatePendingAction' ();

// a list group of the open form the action runs in, by its name, switched to one of its views - GRID, PIVOT, ... -, as
// the switch on a client's toolbar asks for it: a pivot holds the group's changes back until it is updated
changeListView INTERNAL 'lsfusion.tests.ChangeListViewAction' (STRING, STRING);
