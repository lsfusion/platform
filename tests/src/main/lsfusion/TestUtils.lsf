MODULE TestUtils;

REQUIRE System;

// the only way to make a test action fail : the message ends up in the http response the runner reports. NULL: a message
// names the values an assertion compared, so it is NULL when one of them is, and an INTERNAL action skips a NULL argument
fail 'Fail' (STRING message) INTERNAL 'lsfusion.tests.FailAction' (STRING) NULL;

assertTrue (BOOLEAN value, STRING message) {
    IF NOT value THEN
        fail(message);
}

assertFalse (BOOLEAN value, STRING message) {
    IF value THEN
        fail(message);
}

assertNull (value, STRING message) {
    IF value THEN
        fail(message);
}

assertNotNull (value, STRING message) {
    IF NOT value THEN
        fail(message);
}

assertEquals (a, b, STRING message) {
    IF NOT (a = b) THEN
        fail(message);
}

// whether a group of the open form the action runs in has an object in one of its rows, as of the last readShown(): the
// rows the form sends its client, read the way the form reads them before it answers it - which a form with no client
// never does. A level of a tree gets its rows under every open row of the level above, whether that one is shown or not
shownInForm = DATA LOCAL BOOLEAN (Object);
readShownRows INTERNAL 'lsfusion.tests.ReadShownAction' ();
readShown () {
    shownInForm(Object o) <- NULL;
    readShownRows();
}
