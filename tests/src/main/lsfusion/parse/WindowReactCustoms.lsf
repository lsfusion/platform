MODULE WindowReactCustoms;

REQUIRE TestUtils, SystemEvents;

// System.customWindow: the React component that draws a window, which the server writes for every window at start - as
// the window is after the statements that give it CUSTOM, NULL for one drawn otherwise. The windows are the test's own,
// and the suite's browser application loads every module, so they are hidden - in strips of System.forms' area, as
// UiFormsWindow's are - and the component given to them, WrcNothing (WindowReactCustoms.js), draws nothing
WINDOW wrcReplaced VERTICAL POSITION(20, 11, 80, 1) HIDETITLE CUSTOM 'WrcNothing';
EXTEND WINDOW wrcReplaced CUSTOM '<div/>';
HIDE WINDOW wrcReplaced;

WINDOW wrcBack VERTICAL POSITION(20, 12, 80, 1) HIDETITLE CUSTOM '<div/>';
EXTEND WINDOW wrcBack CUSTOM 'WrcNothing';
HIDE WINDOW wrcBack;

WINDOW wrcForms FORMS POSITION(20, 13, 80, 1) HIDETITLE CUSTOM 'WrcNothing';
HIDE WINDOW wrcForms;

// a template given after a component takes the component back, and a component given after a template is written
testCustomWindow 'The server writes the component of every window at start, NULL for one drawn otherwise' () {
    assertNull(customWindow('WindowReactCustoms.wrcReplaced'), 'wrcReplaced: a template replaced the component');
    assertEquals(customWindow('WindowReactCustoms.wrcBack'), 'WrcNothing', 'wrcBack: a component replaced the template');
    assertEquals(customWindow('WindowReactCustoms.wrcForms'), 'WrcNothing', 'wrcForms: a component draws the FORMS window');
    assertNull(customWindow('System.root'), 'System.root: no CUSTOM was given');
}

onWebClientInit() + {
    onWebClientInit('WindowReactCustoms.js') <- 1;
}
