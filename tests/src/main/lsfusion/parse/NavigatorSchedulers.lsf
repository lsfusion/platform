MODULE NavigatorSchedulers;

REQUIRE TestUtils;

// the navigator runs the actions NAVIGATOR { SCHEDULE ... } schedules, several of one period (and FIXED) one after the
// other. They were kept in a map by the period, so of two schedules of one period only the one put later was run - of
// two modules as of one. And modules that do not require each other are parsed at once, each in a thread of its own :
// the actions of one period run in the module order now, in an NF list at their modules' versions, as when the modules
// were parsed one after the other

nsEarlier () { MESSAGE 'ns earlier'; }
nsLater () { MESSAGE 'ns later'; }

nsFailure = DATA LOCAL STRING ();
nsScheduleInModuleOrder INTERNAL 'lsfusion.tests.AddNavigatorSchedulersInModuleOrderAction' ();

testNavigatorSchedulersInModuleOrder 'The actions two modules schedule with one period both run, in the module order' () {
    nsScheduleInModuleOrder();
    assertNull(nsFailure(), nsFailure());
}
