MODULE ReactLayouts;

REQUIRE System;

// what a CUSTOM REACT container accepts: a component with `custom = NULL` at any depth under the containers the
// component draws itself, a NOCUSTOM grid property of the rows the component draws, `tabbed` inside what it draws
// (ignored there), and a nested CUSTOM REACT container, which has a view of its own and so is placed like any other
// component the platform draws
CLASS ReactLayoutItem;
reactLayoutName = DATA STRING[20] (ReactLayoutItem);
reactLayoutQty = DATA INTEGER (ReactLayoutItem);
reactLayoutNote = DATA STRING[50] ();

FORM reactLayouts
    OBJECTS i = ReactLayoutItem
    PROPERTIES(i) reactLayoutName, reactLayoutQty NOCUSTOM
    PROPERTIES() reactLayoutNote
;

DESIGN reactLayouts {
    NEW board {
        custom = 'ReactLayoutBoard';
        MOVE BOX(i);
        NEW deep {
            NEW pages {
                tabbed = TRUE;
                NEW firstPage { MOVE PROPERTY(reactLayoutNote()) { custom = NULL; } }
                NEW secondPage;
            }
        }
        NEW island {
            custom = 'ReactLayoutIsland';
        }
    }
}
