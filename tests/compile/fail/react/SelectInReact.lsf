MODULE SelectInReact;

REQUIRE System;

// SELECT alone says what is drawn, not who draws it: the container draws the property from its data, and reaches it by
// its name, which NOEXTID takes away
CLASS SelectItem;
selectQty = DATA INTEGER (SelectItem);

FORM selectInReact
    OBJECTS i = SelectItem
    PROPERTIES(i) selectQty SELECT 'dropdown' NOEXTID
;

DESIGN selectInReact {
    NEW board {
        custom = 'SelectBoard';
        MOVE BOX(i);
    }
}
