MODULE SelectInReact;

REQUIRE System;

// SELECT is a view of the property's own, the platform's, as a CUSTOM render function is: the container places the
// property by its name, which NOEXTID takes away
CLASS SelectItem;
selectQty = DATA INTEGER (SelectItem);

FORM selectInReact
    OBJECTS i = SelectItem
    PROPERTIES(i) selectQty SELECT 'dropdown' NOEXTID
;

DESIGN selectInReact {
    NEW board {
        custom = 'SelectBoard';
        MOVE BOX(i);
    }
}
