MODULE CustomValueOnFilter;

REQUIRE System;

// a user filter's condition is a part of what its FILTERS box holds, which a React view draws as one: the box takes a
// custom, the condition only NULL
CLASS FilterValueItem;
filterValueQty = DATA INTEGER (FilterValueItem);

FORM customValueOnFilter
    OBJECTS i = FilterValueItem
    PROPERTIES(i) filterValueQty FILTER
;

DESIGN customValueOnFilter {
    FILTER(filterValueQty(i)) { custom = 'FilterValueCondition'; }
}
