MODULE NoCustomNoSelectInReact;

REQUIRE System;

// NOCUSTOM given with NOSELECT wins, whichever is written first - a property has one custom, as it has one caption:
// the platform draws the property, which the container then places by its name - and NOEXTID takes that away
CLASS NoSelectItem;
noSelectQty = DATA INTEGER (NoSelectItem);

FORM noSelectInReact
    OBJECTS i = NoSelectItem
    PROPERTIES(i) noSelectQty NOCUSTOM NOSELECT NOEXTID
;

DESIGN noSelectInReact {
    NEW board {
        custom = 'NoSelectBoard';
        MOVE BOX(i);
    }
}
