MODULE NoCustomNoSelectInReact;

REQUIRE System;

// NOCUSTOM and NOSELECT are apart: NOCUSTOM has the platform draw the property, which the container then places by its
// name - and NOEXTID takes that away -, NOSELECT only says the property is no selection
CLASS NoSelectItem;
noSelectQty = DATA INTEGER (NoSelectItem);

FORM noSelectInReact
    OBJECTS i = NoSelectItem
    PROPERTIES(i) noSelectQty NOCUSTOM NOSELECT NOEXTID
;

DESIGN noSelectInReact {
    NEW board {
        custom = 'NoSelectBoard';
        MOVE BOX(i);
    }
}
