MODULE GridRowReservedName;

REQUIRE System;

// a property drawn on the rows of a grid a React view draws, named like a field every row states: it would shadow
// the row's `isCurrent`
CLASS GridRowItem;
gridRowName = DATA STRING[50] (GridRowItem);

FORM gridRowReservedName
    OBJECTS i = GridRowItem
    PROPERTIES(i) gridRowName EXTID 'isCurrent'
;

DESIGN gridRowReservedName {
    BOX(i) { custom = 'ItemGrid'; }
}
