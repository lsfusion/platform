MODULE TabbedCustomInReact;

REQUIRE System;

// `custom` beside `tabbed` on one container is refused wherever the container is - inside what a React component draws
// too, where the custom is a view of its own that the component places
tabbedNote = DATA STRING[50] ();

FORM tabbedCustom
    PROPERTIES() tabbedNote
;

DESIGN tabbedCustom {
    NEW board {
        custom = 'TabbedBoard';
        NEW pages {
            tabbed = TRUE;
            custom = '<div></div>';
            MOVE PROPERTY(tabbedNote());
        }
    }
}
