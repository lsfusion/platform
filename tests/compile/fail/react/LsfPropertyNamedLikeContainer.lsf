MODULE LsfPropertyNamedLikeContainer;

REQUIRE System;

// an <Lsf> names a container by its design identifier and a property of the empty group by its integration name, and
// both are top-level names of the view's data: one container cannot place two things under one name
lsfLikeNote = DATA STRING[50] ();

FORM lsfLikeContainer
    PROPERTIES() lsfLikeNote EXTID 'pages'
;

DESIGN lsfLikeContainer {
    NEW board {
        custom = 'LsfLikeBoard';
        NEW pages { lsf = TRUE; }
        MOVE PROPERTY(lsfLikeNote()) { lsf = TRUE; }
    }
}
