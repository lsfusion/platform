MODULE SortingNameAcrossContainers;

REQUIRE System;

// a grid property and a platform-drawn panel property of one group under one integration name, React carrying them in
// different containers - the grid's where its rows are drawn, the panel one's where it is placed: no node carries both,
// but a sorting names a property of the GROUP by that name, wherever it is drawn, so it would name neither
CLASS PlatformScopesItem;
platformScopesList = DATA STRING[50] (PlatformScopesItem);
platformScopesPanel = DATA STRING[50] (PlatformScopesItem);

FORM platformListPanelScopes
    OBJECTS i = PlatformScopesItem
    PROPERTIES(i) platformScopesList EXTID 'note', platformScopesPanel PANEL EXTID 'note'
;

DESIGN platformListPanelScopes {
    NEW rowsBoard {
        custom = 'PlatformScopesRows';
        MOVE GRID(i);
    }
    NEW panelBoard {
        custom = 'PlatformScopesPanel';
        MOVE PROPERTY(platformScopesPanel(i)) { custom = NULL; }
    }
}
