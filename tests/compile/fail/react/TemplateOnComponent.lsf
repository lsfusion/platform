MODULE TemplateOnComponent;

REQUIRE System;

// a grid takes NULL or the name of its group's CUSTOM render function: a template, '' and a property lay out the
// children of a container, which it has none of
CLASS TemplateItem;
templateQty = DATA INTEGER (TemplateItem);

FORM templateOnComponent
    OBJECTS i = TemplateItem
    PROPERTIES(i) templateQty
;

DESIGN templateOnComponent {
    GRID(i) { custom = '<div class="frame">rows</div>'; }
}
