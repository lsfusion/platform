MODULE LsfActionBringsItsGroup;

REQUIRE System;

// an lsf action is a part of its group as an lsf property is: its entry, saying whether the form shows it, is on its
// group's node where React places it - data.i, which a form-level property named 'i' would take
CLASS LsfActionGroupItem;
lsfActionGroupGo (LsfActionGroupItem i) { MESSAGE 'go'; }
lsfActionGroupTotal = DATA INTEGER ();

FORM lsfActionBringsItsGroup
    OBJECTS i = LsfActionGroupItem PANEL
    PROPERTIES(i) lsfActionGroupGo EXTID 'go'
    PROPERTIES() lsfActionGroupTotal EXTID 'i'
;

DESIGN lsfActionBringsItsGroup {
    NEW board {
        custom = 'LsfActionGroupBoard';
        MOVE PROPERTY(lsfActionGroupGo(i)) { lsf = TRUE; }
        MOVE PROPERTY(lsfActionGroupTotal());
    }
}
