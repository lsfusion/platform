MODULE ReservedProjectedName;

REQUIRE System;

// a property of the empty group named like what a react view's controller carries beside its members - here the
// form's controller, `form`: its member would shadow it
reservedNote = DATA STRING[50] ();

FORM reservedName
    PROPERTIES() reservedNote EXTID 'form'
;

DESIGN reservedName {
    NEW board {
        custom = 'ReservedBoard';
        MOVE PROPERTY(reservedNote());
    }
}
