MODULE CustomValueOnProperty;

REQUIRE System;

// a component that is not a container takes `custom = NULL`, the platform's standard view, and nothing else: a custom
// view of its own is a container's
customValueNote = DATA STRING[50] ();

FORM customValueOnProperty
    PROPERTIES() customValueNote
;

DESIGN customValueOnProperty {
    MOVE PROPERTY(customValueNote()) { custom = 'CustomValueBoard'; }
}
