MODULE PropertyFilterPlacedFiltersOff;

REQUIRE System;

// the toolbar turning the filters off leaves the platform no filter panel to draw a FILTER a React view places
CLASS PfFiltersOffItem;
pfFiltersOffName = DATA STRING[20] (PfFiltersOffItem);

FORM propertyFilterPlacedFiltersOff
    OBJECTS i = PfFiltersOffItem
    PROPERTIES(i) pfFiltersOffName FILTER
;

DESIGN propertyFilterPlacedFiltersOff {
    TOOLBARSYSTEM(i) { showFilters = FALSE; }
    NEW search FIRST {
        custom = 'PfFiltersOffSearch';
        MOVE FILTER(pfFiltersOffName(i)) { custom = NULL; }
    }
}
